{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "amount": {
      "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,2})?$",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "incurredOn": {
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "type": "string"
    },
    "merchant": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "notes": {
      "maxLength": 2000,
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "schemaVersion",
    "merchant",
    "amount",
    "currency",
    "incurredOn",
    "confidence"
  ],
  "title": "OcrExtractionResultV1",
  "type": "object"
}
