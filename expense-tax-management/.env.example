# ==============================================================================
# EXPENSE TAX MANAGEMENT — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ─── 1. CORE BACKEND SETTINGS ───
PROJECT_NAME="Expense Tax Management API"
VERSION="0.1.0"
SECRET_KEY="dev-secret-key-change-in-production-expense-tax-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── 2. DATABASE (PostgreSQL 17 + pgvector) ───
# Local Dev (host machine):
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5433/expense_tax_db"
# Docker Compose network:
# DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@postgres:5432/expense_tax_db"

# ─── 3. TEMPORAL WORKFLOW ENGINE ───
TEMPORAL_HOST="localhost:7233"
# The "default" namespace ships with the shared Temporal server out of the
# box; no bootstrap step is required. A dedicated namespace only earns its
# keep once a second app actually shares this Temporal server -- revisit then.
TEMPORAL_NAMESPACE="default"

# ─── 4. KNOWLEDGE GRAPH (Neo4j 5.26+ Community) ───
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password123"

# ─── 5. FILE STORAGE (GCS / Local) ───
STORAGE_BACKEND="local" # "local" or "gcs" ("gcs" refused until the GCP infrastructure gate)
LOCAL_STORAGE_DIR="/tmp/expense_tax_storage"
# Base URL stamped into bearer-free signed content URLs. These URLs leave
# the cluster (external clients fetch them directly), so this must be an
# address the *client* can reach -- the loopback-published app-api port
# for local dev, not a container-network hostname.
STORAGE_LOCAL_BASE_URL="http://127.0.0.1:8100"
# HMAC key for bearer-free signed content URLs. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
STORAGE_URL_SIGNING_KEY="change-me-dev-only"
GCS_BUCKET_NAME="expense-receipts-dev"
GCS_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# ─── 5B. FORWARDED RECEIPT INTAKE (LOCAL) ───
INBOUND_EMAIL_BASE_ADDRESS="receipts@inbound.expense-tax.local"
# Provider-webhook HMAC key and deterministic routing-token derivation key.
# Generate separately with: python3 -c "import secrets; print(secrets.token_hex(32))"
INBOUND_WEBHOOK_SIGNING_KEY="change-me-dev-webhook-only"
INBOUND_ROUTING_TOKEN_SECRET="change-me-dev-routing-only"
# Local sender-verification delivery adapter writes one 0600 token file here.
# Real email delivery needs provider credentials and remains pre-release work.
INBOUND_CHALLENGE_DIR="/tmp/expense_tax_inbound_challenges"

# ─── 6. LLM & VISION OCR PROVIDERS ───
# Options: "openai" | "openrouter" | "paddleocr"
LLM_PROVIDER="openai"
OPENAI_API_KEY="sk-..."
OPENROUTER_API_KEY="sk-or-..."

# ─── 7. GMAIL OAUTH (Phase 2D) ───
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/gmail/callback"

# ─── 8. FRONTEND CLIENT (Next.js 16 PWA) ───
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ─── 9. PHASE 0I LOCAL APP/FOUNDRY DATABASE ROLES ───
APP_ENV="development"
COMPOSE_PROFILES="phase-0i-migrations"
APP_MIGRATOR_DB_PASSWORD="expense-tax-app-migrator-local"
APP_RUNTIME_DB_PASSWORD="expense-tax-app-runtime-local"
FOUNDRY_MIGRATOR_DB_PASSWORD="expense-tax-foundry-migrator-local"
FOUNDRY_RUNTIME_DB_PASSWORD="expense-tax-foundry-runtime-local"
APP_DATABASE_URL="postgresql://expense_app_runtime:expense-tax-app-runtime-local@postgres:5432/expense_tax_db"
APP_MIGRATION_DATABASE_URL="postgresql://expense_app_migrator:expense-tax-app-migrator-local@postgres:5432/expense_tax_db"
FOUNDRY_DATABASE_URL="postgresql://expense_foundry_runtime:expense-tax-foundry-runtime-local@postgres:5432/expense_tax_db"
FOUNDRY_MIGRATION_DATABASE_URL="postgresql://expense_foundry_migrator:expense-tax-foundry-migrator-local@postgres:5432/expense_tax_db"
