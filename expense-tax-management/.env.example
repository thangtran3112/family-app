# ==============================================================================
# EXPENSE TAX MANAGEMENT — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ─── 1. CORE BACKEND SETTINGS ───
PROJECT_NAME="Expense Tax Management API"
VERSION="0.1.0"
SECRET_KEY="dev-secret-key-change-in-production-expense-tax-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── 2. DATABASE (PostgreSQL 17 + pgvector) ───
# Local Dev (host machine):
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/expense_tax_db"
# Docker Compose network:
# DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@postgres:5432/expense_tax_db"

# ─── 3. TEMPORAL WORKFLOW ENGINE ───
TEMPORAL_HOST="localhost:7233"
TEMPORAL_NAMESPACE="expense-management"

# ─── 4. KNOWLEDGE GRAPH (Neo4j 5.26+ Community) ───
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password123"

# ─── 5. FILE STORAGE (GCS / Local) ───
STORAGE_BACKEND="local" # "local" or "gcs"
LOCAL_STORAGE_DIR="/tmp/expense_tax_storage"
GCS_BUCKET_NAME="expense-receipts-dev"
GCS_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# ─── 6. LLM & VISION OCR PROVIDERS ───
# Options: "openai" | "openrouter" | "paddleocr"
LLM_PROVIDER="openai"
OPENAI_API_KEY="sk-..."
OPENROUTER_API_KEY="sk-or-..."

# ─── 7. GMAIL OAUTH (Phase 2D) ───
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/gmail/callback"

# ─── 8. FRONTEND CLIENT (Next.js 16 PWA) ───
NEXT_PUBLIC_API_URL="http://localhost:8000"
