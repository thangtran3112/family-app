{
  "schemaVersion": 1,
  "kind": "filter_preset",
  "id": "abnormal-volume",
  "name": "Abnormal volume",
  "description": "Bar volume at least a multiple of its trailing average volume",
  "category": "volume",
  "params": [],
  "strategy": {
    "schemaVersion": 1,
    "kind": "filter",
    "name": "Abnormal volume",
    "timeframe": "1d",
    "preset": {
      "id": "abnormal-volume",
      "params": {}
    },
    "match": {
      "all": [
        {
          "metric": "volume_ratio",
          "lookback": 20,
          "op": "gte",
          "threshold": 2
        }
      ]
    }
  }
}
