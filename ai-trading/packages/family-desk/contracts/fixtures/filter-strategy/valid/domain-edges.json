{
  "schemaVersion": 1,
  "kind": "filter",
  "name": "Domain edges",
  "timeframe": "1d",
  "match": {
    "all": [
      { "metric": "rsi", "lookback": 14, "op": "gte", "threshold": 0 },
      { "metric": "rsi", "lookback": 14, "op": "lte", "threshold": 100 },
      { "metric": "volatility_percentile", "measure": "stdev", "lookback": 20, "window": 20, "op": "between", "min": 0, "max": 100 },
      { "metric": "gap_pct", "op": "gte", "threshold": -100 },
      { "metric": "change_pct", "lookback": 1, "op": "lt", "threshold": -0.5 }
    ]
  }
}
