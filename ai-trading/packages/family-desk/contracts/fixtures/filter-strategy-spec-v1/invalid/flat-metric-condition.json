{
  "schemaVersion": 1,
  "name": "Abnormal volume",
  "watch": {
    "universe": {
      "market": "us_equities"
    },
    "session": "regular",
    "runOn": "bar_close_15m"
  },
  "liquidity": {
    "minPrice": 5,
    "minAvgVolume": 500000
  },
  "when": {
    "metric": "volume_ratio",
    "operator": ">=",
    "threshold": 2
  },
  "rank": {
    "by": {
      "series": "rvol",
      "lookbackDays": 10
    },
    "order": "desc"
  },
  "maxResults": 50
}
