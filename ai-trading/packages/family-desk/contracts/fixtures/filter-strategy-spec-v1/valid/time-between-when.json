{
  "schemaVersion": 1,
  "name": "Opening window volume",
  "watch": {
    "universe": {
      "market": "us_equities"
    },
    "session": "regular",
    "runOn": "bar_close_5m"
  },
  "when": {
    "all": [
      {
        "op": "time_between",
        "start": "09:30",
        "end": "11:00"
      },
      {
        "op": "gte",
        "left": {
          "series": "rvol",
          "lookbackDays": 10
        },
        "right": {
          "value": 2
        }
      }
    ]
  },
  "maxResults": 20
}
