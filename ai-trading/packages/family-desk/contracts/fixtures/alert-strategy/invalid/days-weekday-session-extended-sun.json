{
  "schemaVersion": 1,
  "kind": "alert",
  "name": "Sunday extended session",
  "timeframe": "1d",
  "trigger": { "type": "strategy_match", "strategyId": "abnormal-volume" },
  "schedule": { "sessions": "extended", "days": ["sun"] },
  "cooldown": { "minutes": 60, "dedupe": "per_symbol" },
  "channels": ["in_app"]
}
