{
  "schemaVersion": 1,
  "name": "Volume spike alert",
  "when": {
    "op": "gte",
    "left": {
      "series": "rvol",
      "lookbackDays": 10
    },
    "right": {
      "value": 3
    }
  },
  "then": {
    "alert": {
      "channels": [
        "inbox"
      ],
      "severity": "info"
    }
  }
}
