{
  "schemaVersion": 1,
  "kind": "alert",
  "name": "Strategy match with a ticker",
  "timeframe": "1d",
  "trigger": { "type": "strategy_match", "strategyId": "abnormal-volume", "symbol": "AAPL" },
  "schedule": { "sessions": "always", "days": ["mon"] },
  "cooldown": { "minutes": 60, "dedupe": "per_symbol" },
  "channels": ["in_app"]
}
