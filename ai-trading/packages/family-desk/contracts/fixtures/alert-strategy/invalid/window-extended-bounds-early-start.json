{
  "schemaVersion": 1,
  "kind": "alert",
  "name": "Extended window starts before 04:00",
  "timeframe": "1d",
  "trigger": { "type": "strategy_match", "strategyId": "abnormal-volume" },
  "schedule": {
    "sessions": "extended",
    "days": ["mon", "tue", "wed", "thu", "fri"],
    "window": { "start": "03:00", "end": "10:00" }
  },
  "cooldown": { "minutes": 60, "dedupe": "per_symbol" },
  "channels": ["in_app"]
}
