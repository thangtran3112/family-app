{
  "schemaVersion": 1,
  "name": "Volume spike alert",
  "watch": {
    "universe": {
      "watchlist": "Day movers"
    },
    "session": "regular",
    "runOn": "bar_close_15m"
  },
  "when": {
    "op": "pattern",
    "pattern": "bull_flag"
  },
  "then": {
    "alert": {
      "channels": [
        "inbox"
      ],
      "severity": "info"
    }
  }
}
