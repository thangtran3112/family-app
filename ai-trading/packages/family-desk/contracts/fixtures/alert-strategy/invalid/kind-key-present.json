{
  "schemaVersion": 1,
  "name": "Volume spike alert",
  "watch": {
    "universe": {
      "watchlist": "Day movers"
    },
    "session": "regular",
    "runOn": "bar_close_15m"
  },
  "when": {
    "op": "gte",
    "left": {
      "series": "rvol",
      "lookbackDays": 10
    },
    "right": {
      "value": 3
    }
  },
  "then": {
    "alert": {
      "channels": [
        "inbox"
      ],
      "severity": "info"
    }
  },
  "kind": "alert"
}
