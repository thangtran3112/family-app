{
  "schemaVersion": 1,
  "kind": "alert",
  "name": "Regular window starts before the open",
  "timeframe": "1d",
  "trigger": { "type": "strategy_match", "strategyId": "abnormal-volume" },
  "schedule": {
    "sessions": "regular",
    "days": ["mon", "tue", "wed", "thu", "fri"],
    "window": { "start": "09:00", "end": "12:00" }
  },
  "cooldown": { "minutes": 60, "dedupe": "per_symbol" },
  "channels": ["in_app"]
}
