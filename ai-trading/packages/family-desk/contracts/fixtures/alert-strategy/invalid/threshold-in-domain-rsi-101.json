{
  "schemaVersion": 1,
  "kind": "alert",
  "name": "RSI above its maximum",
  "timeframe": "1h",
  "trigger": {
    "type": "indicator_threshold",
    "symbol": "AAPL",
    "indicator": { "metric": "rsi", "lookback": 14 },
    "op": "gt",
    "threshold": 101
  },
  "schedule": { "sessions": "always", "days": ["mon"] },
  "cooldown": { "minutes": 60, "dedupe": "per_symbol" },
  "channels": ["in_app"]
}
