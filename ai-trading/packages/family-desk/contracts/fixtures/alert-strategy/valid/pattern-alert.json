{
  "schemaVersion": 1,
  "name": "Hammer after selloff",
  "watch": {
    "universe": {
      "watchlist": "Day movers"
    },
    "session": "regular",
    "runOn": "bar_close_15m"
  },
  "when": {
    "op": "pattern",
    "pattern": "hammer",
    "trend": "after_downtrend",
    "trendBars": 5,
    "withinBars": 1
  },
  "then": {
    "alert": {
      "channels": [
        "inbox"
      ],
      "severity": "opportunity"
    }
  }
}
