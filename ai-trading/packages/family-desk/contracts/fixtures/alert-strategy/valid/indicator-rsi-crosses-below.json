{
  "schemaVersion": 1,
  "kind": "alert",
  "name": "AAPL RSI crosses below 30",
  "timeframe": "1h",
  "trigger": {
    "type": "indicator_threshold",
    "symbol": "AAPL",
    "indicator": { "metric": "rsi", "lookback": 14 },
    "op": "crosses_below",
    "threshold": 30
  },
  "schedule": {
    "sessions": "regular",
    "days": ["mon", "tue", "wed", "thu", "fri"],
    "window": { "start": "10:00", "end": "15:30" }
  },
  "cooldown": { "minutes": 30, "dedupe": "per_symbol" },
  "maxPerDay": 5,
  "channels": ["in_app", "telegram", "slack"]
}
