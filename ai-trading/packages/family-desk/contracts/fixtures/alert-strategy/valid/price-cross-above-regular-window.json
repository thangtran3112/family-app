{
  "schemaVersion": 1,
  "kind": "alert",
  "name": "AAPL breaks 200",
  "description": "Tell me when AAPL trades above 200 during the regular session.",
  "severity": "opportunity",
  "timeframe": "1m",
  "trigger": { "type": "price_cross", "symbol": "AAPL", "direction": "above", "level": 200.5 },
  "schedule": {
    "sessions": "regular",
    "days": ["mon", "tue", "wed", "thu", "fri"],
    "window": { "start": "09:30", "end": "16:00" }
  },
  "cooldown": { "minutes": 120, "dedupe": "per_trigger" },
  "maxPerDay": 3,
  "channels": ["in_app", "telegram"]
}
