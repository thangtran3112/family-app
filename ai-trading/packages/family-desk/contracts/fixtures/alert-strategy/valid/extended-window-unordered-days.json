{
  "schemaVersion": 1,
  "kind": "alert",
  "name": "Pre-market gap check",
  "timeframe": "1m",
  "trigger": {
    "type": "indicator_threshold",
    "symbol": "TSLA",
    "indicator": { "metric": "gap_pct" },
    "op": "lte",
    "threshold": -3
  },
  "schedule": {
    "sessions": "extended",
    "days": ["fri", "mon", "wed"],
    "window": { "start": "09:00", "end": "12:00" }
  },
  "cooldown": { "minutes": 45, "dedupe": "per_trigger" },
  "channels": ["in_app", "slack"]
}
