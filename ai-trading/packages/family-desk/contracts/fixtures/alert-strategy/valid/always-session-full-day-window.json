{
  "schemaVersion": 1,
  "kind": "alert",
  "name": "Any hour, Mon/Wed/Fri",
  "timeframe": "1h",
  "trigger": { "type": "strategy_match", "strategyId": "gap-up" },
  "schedule": {
    "sessions": "always",
    "days": ["mon", "wed", "fri"],
    "window": { "start": "00:00", "end": "23:59" }
  },
  "cooldown": { "minutes": 240, "dedupe": "per_trigger" },
  "channels": ["in_app", "telegram"]
}
