{
  "schemaVersion": 1,
  "kind": "alert",
  "name": "Five-bar drop of 10 percent",
  "timeframe": "5m",
  "trigger": {
    "type": "indicator_threshold",
    "symbol": "NVDA",
    "indicator": { "metric": "change_pct", "lookback": 5 },
    "op": "lt",
    "threshold": -10
  },
  "schedule": {
    "sessions": "extended",
    "days": ["mon", "tue", "wed", "thu", "fri"],
    "window": { "start": "04:00", "end": "20:00" }
  },
  "cooldown": { "minutes": 15, "dedupe": "per_symbol" },
  "channels": ["in_app", "slack"]
}
