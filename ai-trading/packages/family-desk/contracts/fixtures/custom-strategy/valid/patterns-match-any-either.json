      },
      {
        "spec": {
          "pattern": "breakout",
          "direction": "bearish",
          "timeframe": "1h",
          "lookback": 20,
          "confirmation": { "type": "none" },
          "tolerance": { "bufferPct": 0.2 }
        }
      }
    ]
  }
