{
  "schemaVersion": 1,
  "kind": "custom",
  "name": "Hammer or doji, long only",
  "timeframe": "1d",
  "direction": "long",
  "patterns": {
    "match": "any",
    "entries": [
      {
        "spec": {
          "pattern": "hammer",
          "direction": "bullish",
          "timeframe": "1d",
          "priorTrend": { "direction": "down", "bars": 3 },
          "confirmation": { "type": "next_bar_close", "bars": 1 },
          "tolerance": { "shadowMinRatio": 2, "bodyMaxPct": 35 }
        }
      },
      {
        "spec": {
          "pattern": "doji",
          "direction": "neutral",
          "timeframe": "1d",
          "confirmation": { "type": "none" },
          "tolerance": { "bodyMaxPct": 10 }
        }
      }
    ]
  }
}
