{
  "schemaVersion": 1,
  "kind": "custom",
  "name": "Liquid gaps or volume spikes",
  "description": "Liquid names with a gap up or a volume spike, or a deep oversold bounce setup",
  "timeframe": "1d",
  "direction": "long",
  "filters": {
    "all": [
      { "metric": "avg_volume", "lookback": 20, "op": "gte", "threshold": 500000 },
      {
        "any": [
          { "metric": "gap_pct", "op": "between", "min": 3, "max": 15 },
          { "metric": "volume_ratio", "lookback": 20, "op": "gte", "threshold": 2.5 },
          {
            "all": [
              { "metric": "rsi", "lookback": 14, "op": "lt", "threshold": 30 },
              { "metric": "pct_from_high", "lookback": 252, "op": "gt", "threshold": 40 }
            ]
          }
        ]
      }
    ]
  }
}
