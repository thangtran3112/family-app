{
  "schemaVersion": 1,
  "kind": "custom",
  "name": "Smallest sizes and widest R target",
  "timeframe": "1m",
  "direction": "either",
  "filters": { "all": [{ "metric": "close", "op": "gt", "threshold": 0.01 }] },
