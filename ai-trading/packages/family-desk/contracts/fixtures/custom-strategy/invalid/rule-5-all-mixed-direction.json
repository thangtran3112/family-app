{
  "schemaVersion": 1,
  "kind": "custom",
  "name": "Bullish and bearish, all must match",
  "timeframe": "1d",
  "direction": "either",
  "patterns": {
    "match": "all",
    "entries": [
      {
        "spec": {
          "pattern": "hammer",
          "direction": "bullish",
          "timeframe": "1d",
          "confirmation": { "type": "none" },
          "tolerance": { "shadowMinRatio": 2, "bodyMaxPct": 35 }
        }
      },
      {
        "spec": {
          "pattern": "bearish_engulfing",
          "direction": "bearish",
          "timeframe": "1d",
          "confirmation": { "type": "none" },
          "tolerance": { "engulfMinRatio": 1 }
        }
      }
    ]
  }
}
