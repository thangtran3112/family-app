{
  "schemaVersion": 1,
  "name": "Fixture",
  "watch": {
    "universe": {
      "watchlist": "Swing"
    },
    "session": "regular",
    "runOn": "daily_close"
  },
  "when": {
    "op": "gt",
    "left": {
      "series": "close"
    },
    "right": {
      "value": 100
    }
  },
  "then": {
    "alert": {
      "channels": [
        "inbox",
        "telegram"
      ],
      "severity": "opportunity",
      "frequency": "once_per_bar",
      "expiresOn": "2027-01-15",
      "message": "{symbol} at {close} ({time})"
    }
  }
}
