{
  "schemaVersion": 1,
  "name": "Fixture",
  "watch": {
    "universe": {
      "watchlist": "Swing"
    },
    "session": "regular",
    "runOn": "bar_close_5m"
  },
  "when": {
    "op": "crosses_above",
    "left": {
      "series": "close"
    },
    "right": {
      "level": "session_high"
    }
  },
  "then": {
    "alert": {
      "channels": [
        "inbox"
      ]
    }
  }
}
