{
  "schemaVersion": 1,
  "draftId": "draft-config-target-alert-config-for-filter-target",
  "createdAt": "2026-10-23T14:30:00Z",
  "request": "Find US stocks with relative volume of at least 3x on each 15-minute bar close.",
  "rationale": "3x RVOL on 15-minute bars flags unusual volume; ranking by RVOL puts the strongest names first.",
  "status": "proposed",
  "target": "filter",
  "draftConfig": {
    "schemaVersion": 1,
    "name": "Volume spike alert",
    "watch": {
      "universe": {
        "watchlist": "Day movers"
      },
      "session": "regular",
      "runOn": "bar_close_15m"
    },
    "when": {
      "op": "gte",
      "left": {
        "series": "rvol",
        "lookbackDays": 10
      },
      "right": {
        "value": 3
      }
    },
    "then": {
      "alert": {
        "channels": [
          "inbox",
          "telegram"
        ],
        "severity": "info"
      }
    }
  },
  "edits": []
}
