{
  "schemaVersion": 1,
  "kind": "draft",
  "draftId": "draft-volume-spikes-stricter",
  "createdAt": "2026-10-23T14:32:00Z",
  "request": "Same screen, but only a 3x volume spike.",
  "rationale": "Raised the volume ratio threshold from 2 to 3 so only the strongest spikes remain. The rest of the screen is unchanged.",
  "status": "edited",
  "draftConfig": {
    "schemaVersion": 1,
    "kind": "filter",
    "name": "Top volume spikes",
    "timeframe": "1d",
    "match": {
      "all": [
        { "metric": "volume_ratio", "lookback": 20, "op": "gte", "threshold": 2 },
        { "metric": "dollar_volume", "op": "gte", "threshold": 5000000 }
      ]
    },
    "rank": { "by": { "metric": "volume_ratio", "lookback": 20 }, "order": "desc", "limit": 25 }
  },
  "edits": [{ "op": "replace", "path": "/match/all/0/threshold", "value": 3 }]
}
