{
  "schemaVersion": 1,
  "name": "Inverted hammer",
  "watch": { "universe": { "watchlist": "Day movers" }, "session": "regular", "runOn": "bar_close_15m" },
  "when": { "op": "pattern", "pattern": "inverted_hammer", "trend": "after_downtrend", "trendBars": 5, "withinBars": 1 },
  "then": {
    "alert": {
      "channels": ["inbox"],
      "severity": "opportunity",
      "frequency": "once_per_bar",
      "message": "{symbol} inverted hammer on the 15m, close {close} at {time}"
    }
  }
}
