{
  "schemaVersion": 1,
  "name": "Inside bar",
  "watch": { "universe": { "watchlist": "Day movers" }, "session": "regular", "runOn": "bar_close_15m" },
  "when": { "op": "pattern", "pattern": "inside_bar", "withinBars": 1 },
  "then": {
    "alert": {
      "channels": ["inbox"],
      "severity": "info",
      "frequency": "once_per_bar",
      "message": "{symbol} inside bar on the 15m, close {close} at {time}"
    }
  }
}
