{
  "schemaVersion": 1,
  "kind": "filter_preset",
  "id": "gap-up",
  "name": "Gap up",
  "description": "Open at least a percentage above the prior close",
  "category": "gap",
  "params": [
    { "key": "threshold", "label": "Gap at least", "unit": "pct", "path": "/match/all/0/threshold", "default": 3, "min": 1, "max": 10, "step": 0.5 }
  ],
  "strategy": {
    "schemaVersion": 1,
    "kind": "filter",
    "name": "Gap up",
    "timeframe": "1d",
    "preset": { "id": "gap-up", "params": { "threshold": 3 } },
    "match": { "all": [{ "metric": "gap_pct", "op": "gte", "threshold": 3 }] }
  }
}
