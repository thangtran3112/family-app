{
  "schemaVersion": 1,
  "kind": "filter_preset",
  "id": "volatility-stdev-percentile",
  "name": "Return volatility percentile",
  "description": "Standard deviation of bar returns ranks at or above a percentile of its own trailing window",
  "category": "volatility",
  "params": [
    { "key": "threshold", "label": "Percentile at least", "unit": "percentile", "path": "/match/all/0/threshold", "default": 80, "min": 50, "max": 99, "step": 1 },
    { "key": "lookback", "label": "Return window", "unit": "bars", "path": "/match/all/0/lookback", "default": 20, "min": 5, "max": 60 },
    { "key": "window", "label": "Percentile window", "unit": "bars", "path": "/match/all/0/window", "default": 252, "min": 60, "max": 1000 }
  ],
  "strategy": {
    "schemaVersion": 1,
    "kind": "filter",
    "name": "Return volatility percentile",
    "timeframe": "1d",
    "preset": { "id": "volatility-stdev-percentile", "params": { "threshold": 80, "lookback": 20, "window": 252 } },
    "match": {
      "all": [
        { "metric": "volatility_percentile", "measure": "stdev", "lookback": 20, "window": 252, "op": "gte", "threshold": 80 }
      ]
    }
  }
}
