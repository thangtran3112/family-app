{
  "schemaVersion": 1,
  "kind": "filter_preset",
  "id": "price-volume-range",
  "name": "Price and volume range",
  "description": "Close inside a price band, with a minimum 20-bar average volume",
  "category": "range",
  "params": [
    { "key": "minPrice", "label": "Minimum price", "unit": "usd", "path": "/match/all/0/min", "default": 5, "min": 1, "max": 10, "step": 0.5 },
    { "key": "maxPrice", "label": "Maximum price", "unit": "usd", "path": "/match/all/0/max", "default": 50, "min": 20, "max": 500, "step": 1 },
    { "key": "minAvgVolume", "label": "Minimum average volume", "unit": "shares", "path": "/match/all/1/threshold", "default": 1000000, "min": 100000, "max": 10000000, "step": 100000 }
  ],
  "strategy": {
    "schemaVersion": 1,
    "kind": "filter",
    "name": "Price and volume range",
    "timeframe": "1d",
    "preset": { "id": "price-volume-range", "params": { "minPrice": 5, "maxPrice": 50, "minAvgVolume": 1000000 } },
    "match": {
      "all": [
        { "metric": "close", "op": "between", "min": 5, "max": 50 },
        { "metric": "avg_volume", "lookback": 20, "op": "gte", "threshold": 1000000 }
      ]
    }
  }
}
