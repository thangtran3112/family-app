{
  "schemaVersion": 1,
  "kind": "filter_preset",
  "id": "abnormal-volume",
  "name": "Abnormal volume",
  "description": "Bar volume at least a multiple of its trailing average volume",
  "category": "volume",
  "params": [
    { "key": "multiple", "label": "Volume multiple", "unit": "x", "path": "/match/all/0/threshold", "default": 2, "min": 1.2, "max": 20, "step": 0.1 },
    { "key": "lookback", "label": "Average window", "unit": "bars", "path": "/match/all/0/lookback", "default": 20, "min": 5, "max": 60 }
  ],
  "strategy": {
    "schemaVersion": 1,
    "kind": "filter",
    "name": "Abnormal volume",
    "timeframe": "1d",
    "preset": { "id": "abnormal-volume", "params": { "multiple": 2, "lookback": 20 } },
    "match": { "all": [{ "metric": "volume_ratio", "lookback": 20, "op": "gte", "threshold": 2 }] }
  }
}
