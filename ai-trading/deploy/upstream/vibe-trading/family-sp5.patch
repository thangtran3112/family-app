+"""Deploy idle means no chat, pending private launch, or detached private run."""
+
+from __future__ import annotations
+
+import threading
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from src.agent.committee_gate import CommitteeGate
+from src.session.events import EventBus
+from src.session.service import SessionService
+from src.session.store import SessionStore
+from src.swarm.models import RunStatus, SwarmRun
+from src.swarm.store import SwarmStore
+from src.tools import swarm_tool
+
+
+@pytest.fixture
+def private_root(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
+    root = tmp_path / ".committee"
+    monkeypatch.setattr(swarm_tool, "private_committee_runs_root", lambda: root)
+    return root
+
+
+def test_pending_private_launch_blocks_idle(private_root: Path) -> None:
+    finish = swarm_tool.mark_private_launch()
+    try:
+        assert swarm_tool.active_private_committee_work() == 1
+    finally:
+        finish()
+        finish()  # Cleanup must not make the counter negative.
+    assert swarm_tool.active_private_committee_work() == 0
+
+
+def test_persisted_private_run_stays_active_after_launcher_returns(private_root: Path) -> None:
+    store = SwarmStore(private_root)
+    run = SwarmRun(
+        id="run-1", preset_name="investment_committee",
+        created_at=datetime.now(timezone.utc).isoformat(),
+    )
+    finish = swarm_tool.mark_private_launch()
+    store.create_run(run)
+    assert swarm_tool.active_private_committee_work() == 2
+    finish()
+    assert swarm_tool.active_private_committee_work() == 1
+    run.status = RunStatus.running
+    store.update_run(run)
+    assert swarm_tool.active_private_committee_work() == 1
+    run.status = RunStatus.completed
+    store.update_run(run)
+    assert swarm_tool.active_private_committee_work() == 0
+
+
+def test_public_swarm_is_outside_private_deploy_scope(private_root: Path) -> None:
+    store = SwarmStore(private_root.parent / "public")
+    store.create_run(SwarmRun(
+        id="manual-run", preset_name="risk_committee",
+        created_at=datetime.now(timezone.utc).isoformat(),
+    ))
+    assert swarm_tool.active_private_committee_work() == 0
+
+
+def test_corrupt_private_run_refuses_idle(private_root: Path) -> None:
+    broken = private_root / "damaged" / "run.json"
+    broken.parent.mkdir(parents=True)
+    broken.write_text("{", encoding="utf-8")
+    with pytest.raises((OSError, ValueError)):
+        swarm_tool.active_private_committee_work()
+
+
+def test_running_run_beyond_first_fifty_still_blocks_deploy(private_root: Path) -> None:
+    store = SwarmStore(private_root)
+    for number in range(51):
+        store.create_run(SwarmRun(
+            id=f"older-{number}", preset_name="investment_committee",
+            status=RunStatus.completed,
+            created_at=datetime.now(timezone.utc).isoformat(),
+        ))
+    store.create_run(SwarmRun(
+        id="active-after-fifty", preset_name="investment_committee",
+        created_at=datetime.now(timezone.utc).isoformat(),
+    ))
+    assert swarm_tool.active_private_committee_work() == 1
+
+
+def test_session_release_before_private_persistence_does_not_report_idle(
+    private_root: Path, monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    index = SimpleNamespace(index_session=lambda *a: None, index_message=lambda *a: None)
+    monkeypatch.setattr("src.session.service.get_shared_index", lambda: index)
+    service = SessionService(SessionStore(private_root.parent / "sessions"), EventBus(), private_root.parent / "runs")
+    session = service.create_session("handoff")
+    service._reserve_session(session.session_id)
+    lease = service.start_deploy_drain()
+    assert service.deploy_drain_status(lease)["active_chat"] == 1
+    finish = swarm_tool.mark_private_launch()
+    service._release_session(session.session_id)
+    try:
+        assert service.deploy_drain_status(lease)["active_private_committees"] == 1
+    finally:
+        finish()
+        service.end_deploy_drain(lease)
+
+
+def test_real_committee_launcher_remains_counted_after_parent_cancels(
+    private_root: Path, monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    started = threading.Event()
+    release = threading.Event()
+
+    class Registry:
+        def get(self, _name):
+            return None
+
+        def execute(self, name, _params):
+            assert name == "run_swarm"
+            started.set()
+            assert release.wait(5)
+            return '{"status":"failed"}'
+
+    gate = CommitteeGate(
+        "Should I buy AAPL.US?", None,
+        bridge_fetcher=lambda *_: {"status": "unavailable", "reason": "not_configured"},
+    )
+    parent_dir = private_root.parent / "parent-run"
+    ledger = SimpleNamespace(run_dir=str(parent_dir))
+    try:
+        gate.orchestrate(
+            Registry(), "Should I buy AAPL.US?", "AAPL.US", ledger, parent_dir,
+            now=datetime.now(timezone.utc), should_cancel=started.is_set,
+        )
+        assert started.is_set()
+        assert swarm_tool.active_private_committee_work() == 1
+    finally:
+        release.set()
+    for _ in range(100):
+        if swarm_tool.active_private_committee_work() == 0:
+            break
+        time.sleep(0.01)
+    assert swarm_tool.active_private_committee_work() == 0
