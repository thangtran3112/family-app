+"""Loopback-only Vibe chat drain control for the ai-trading deploy driver."""
+
+from __future__ import annotations
+
+import ipaddress
+import sys
+
+from fastapi import Depends, FastAPI, Header, HTTPException, Request
+
+
+def register_deploy_routes(app: FastAPI) -> None:
+    host = sys.modules.get("api_server") or sys.modules.get("agent.api_server")
+    if host is None:
+        raise RuntimeError("Import api_server before registering deploy routes")
+    require_auth = host.require_auth
+
+    def local_service(request: Request):
+        try:
+            loopback = ipaddress.ip_address(request.client.host).is_loopback
+        except (AttributeError, ValueError):
+            loopback = False
+        if not loopback:
+            raise HTTPException(status_code=403, detail="Local deploy control only")
+        service = host._get_session_service()
+        if service is None:
+            raise HTTPException(status_code=501, detail="Session runtime not enabled")
+        return service
+
+    @app.post("/internal/deploy/drain", dependencies=[Depends(require_auth)])
+    async def begin_deploy_drain(request: Request):
+        service = local_service(request)
+        try:
+            lease = service.start_deploy_drain()
+        except ValueError as exc:
+            raise HTTPException(status_code=409, detail="Deploy drain already active") from exc
+        try:
+            counts = service.deploy_drain_status(lease)
+        except (OSError, ValueError) as exc:
+            service.end_deploy_drain(lease)
+            raise HTTPException(status_code=503, detail="Deploy state unavailable") from exc
+        return {"lease": lease, **counts}
+
+    @app.get("/internal/deploy/drain", dependencies=[Depends(require_auth)])
+    async def deploy_drain_status(request: Request, lease: str = Header(alias="X-Deploy-Lease")):
+        service = local_service(request)
+        try:
+            return service.deploy_drain_status(lease)
+        except ValueError as exc:
+            raise HTTPException(status_code=409, detail="Deploy lease invalid") from exc
+        except OSError as exc:
+            raise HTTPException(status_code=503, detail="Deploy state unavailable") from exc
+
+    @app.post("/internal/deploy/drain/renew", dependencies=[Depends(require_auth)])
+    async def renew_deploy_drain(request: Request, lease: str = Header(alias="X-Deploy-Lease")):
+        service = local_service(request)
+        try:
+            service.renew_deploy_drain(lease)
+        except ValueError as exc:
+            raise HTTPException(status_code=409, detail="Deploy lease invalid") from exc
+        return {"status": "renewed"}
+
+    @app.delete("/internal/deploy/drain", dependencies=[Depends(require_auth)])
+    async def end_deploy_drain(request: Request, lease: str = Header(alias="X-Deploy-Lease")):
+        service = local_service(request)
+        try:
+            service.end_deploy_drain(lease)
+        except ValueError as exc:
+            raise HTTPException(status_code=409, detail="Deploy lease invalid") from exc
+        return {"status": "released"}
