+def mark_private_launch() -> Callable[[], None]:
+    """Count a committee thread before it can create its durable run."""
+    global _private_launches
+    with _private_launch_lock:
+        _private_launches += 1
+    released = False
+
+    def finish() -> None:
+        nonlocal released
+        global _private_launches
+        with _private_launch_lock:
+            if released:
+                return
+            released = True
+            _private_launches -= 1
+
+    return finish
+
+
+def active_private_committee_work() -> int:
+    """Count every private pending/running run and any launch not yet durable.
+
+    A stale running status blocks deploy rather than guessing a silent worker
+    has exited. Only the private subtree is examined; public swarms are not
+    part of the Vibe chat drain contract.
+    """
+    from src.swarm.models import RunStatus
+    from src.swarm.store import SwarmStore
+
+    root = private_committee_runs_root()
+    active = 0
+    if root.exists() or root.is_symlink():
+        if root.is_symlink() or not root.is_dir():
+            raise OSError("Invalid private committee store")
+        store = SwarmStore(root)
+        # ponytail: scan all private runs per deploy poll; index active IDs only if history makes this slow.
+        for entry in root.iterdir():
