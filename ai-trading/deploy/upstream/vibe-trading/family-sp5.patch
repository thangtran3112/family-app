diff --git a/frontend/src/pages/__tests__/AgentInterruptedRetry.test.tsx b/frontend/src/pages/__tests__/AgentInterruptedRetry.test.tsx
new file mode 100644
index 00000000..be7d5b3e
--- /dev/null
+++ b/frontend/src/pages/__tests__/AgentInterruptedRetry.test.tsx
@@ -0,0 +1,128 @@
+import { act, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { createMemoryRouter, RouterProvider } from "react-router";
+import i18n from "@/i18n";
+import { ApiError } from "@/lib/api";
+import { useAgentStore } from "@/stores/agent";
+import { Agent } from "../Agent";
+
+const prompt = "Should I buy NVDA.US? No orders.";
+const savedHistory = [
+  { message_id: "user-1", session_id: "session-one", role: "user", content: prompt,
+    created_at: "2026-10-16T10:00:00Z" },
+  { message_id: "assistant-1", session_id: "session-one", role: "assistant",
+    content: "Vibe Trading restarted before this response finished.",
+    linked_attempt_id: "attempt-one", created_at: "2026-10-16T10:01:00Z",
+    metadata: { status: "interrupted", retry_prompt: prompt, progress_complete: false },
+    tool_trail: [{ tool: "web_search", status: "ok", elapsed_ms: 12, timestamp: 1_791_801_010_000 }],
+  },
+];
+
+const apiMock = vi.hoisted(() => ({
+  getGoal: vi.fn(),
+  getLLMSettings: vi.fn(),
+  getRun: vi.fn(),
+  getSessionMessages: vi.fn(),
+  listReasoningEfforts: vi.fn(),
+  sendMessage: vi.fn(),
+  sseUrl: vi.fn((sid: string) => `/sessions/${sid}/events`),
+}));
+const sseMock = vi.hoisted(() => ({
+  connect: vi.fn(), disconnect: vi.fn(), onStatusChange: vi.fn(),
+}));
+
+vi.mock("@/lib/api", async () => {
+  const actual = await vi.importActual<typeof import("@/lib/api")>("@/lib/api");
+  return { ...actual, api: apiMock };
+});
+vi.mock("@/hooks/useSSE", () => ({ useSSE: () => sseMock }));
+
+function renderSession() {
+  const router = createMemoryRouter(
+    [{ path: "/", element: <Agent /> }, { path: "/other", element: <div>other</div> }],
+    { initialEntries: ["/?session=session-one"] },
+  );
+  render(<RouterProvider router={router} />);
+  return router;
+}
+
+describe("interrupted Vibe chat retry", () => {
+  beforeEach(async () => {
+    await i18n.changeLanguage("en");
+    useAgentStore.getState().reset();
+    vi.clearAllMocks();
+    apiMock.getGoal.mockResolvedValue(null);
+    apiMock.getSessionMessages.mockResolvedValue(savedHistory);
+    apiMock.getLLMSettings.mockResolvedValue({
+      provider: "openai", model_name: "gpt-6.1-sol", base_url: "https://api.openai.com/v1",
+      api_key_configured: true, api_key_required: true, timeout_seconds: 120,
+      max_retries: 2, reasoning_effort: "xhigh", sse_timeout_seconds: 90, providers: [],
+    });
+    apiMock.listReasoningEfforts.mockResolvedValue({
+      provider: "openai", model_name: "gpt-6.1-sol",
+      efforts: ["low", "medium", "high", "xhigh"], source: "provider",
+    });
+    apiMock.sendMessage.mockResolvedValue({ message_id: "retry-user", attempt_id: "retry-attempt" });
+    Object.defineProperty(HTMLElement.prototype, "scrollTo", { configurable: true, value: vi.fn() });
+  });
+
+  afterEach(() => vi.restoreAllMocks());
+
+  it("hydrates amber interruption and does not auto-resend on navigation/reconnect", async () => {
+    const router = renderSession();
+    await waitFor(() => expect(screen.getByText(/Interrupted · 1 steps/)).toBeInTheDocument());
+    expect(screen.queryByText(/Done · 1 steps/)).not.toBeInTheDocument();
+    expect(screen.getByText(/some actions may have completed/i)).toBeInTheDocument();
+    expect(screen.queryByText(/PRIVATE_RUN_ID|SECRET_PREVIEW/)).not.toBeInTheDocument();
+    await act(async () => { await router.navigate("/other"); });
+    await act(async () => { await router.navigate("/?session=session-one"); });
+    await waitFor(() => expect(screen.getByText(/Interrupted · 1 steps/)).toBeInTheDocument());
+    expect(apiMock.sendMessage).not.toHaveBeenCalled();
+  });
+
+  it("never guesses a retry prompt when the backend omitted it", async () => {
+    apiMock.getSessionMessages.mockResolvedValue([
+      savedHistory[0],
+      { ...savedHistory[1], metadata: { status: "interrupted", progress_complete: false } },
+    ]);
+    renderSession();
+    await waitFor(() => expect(screen.getByText(/Interrupted · 1 steps/)).toBeInTheDocument());
+    expect(screen.getByText(/some actions may have completed/i)).toBeInTheDocument();
+    expect(screen.queryByRole("button", { name: /retry research/i })).not.toBeInTheDocument();
+  });
+
+  it("declined confirmation sends nothing", async () => {
+    vi.spyOn(window, "confirm").mockReturnValue(false);
+    renderSession();
+    const retry = await screen.findByRole("button", { name: /retry research/i });
+    fireEvent.click(retry);
+    expect(apiMock.sendMessage).not.toHaveBeenCalled();
+  });
+
+  it("retries the exact original prompt once even when goal mode is selected", async () => {
+    vi.spyOn(window, "confirm").mockReturnValue(true);
+    renderSession();
+    const retry = await screen.findByRole("button", { name: /retry research/i });
+    fireEvent.click(screen.getByTitle("More options"));
+    fireEvent.click(screen.getByRole("menuitem", { name: "Research Goal" }));
+    let finishSend!: (value: unknown) => void;
+    apiMock.sendMessage.mockImplementation(() => new Promise((resolve) => { finishSend = resolve; }));
+
+    fireEvent.click(retry);
+    fireEvent.click(retry);
+    await waitFor(() => expect(apiMock.sendMessage).toHaveBeenCalledTimes(1));
+    expect(apiMock.sendMessage).toHaveBeenCalledWith("session-one", prompt, { reasoningEffort: undefined });
+    expect(screen.getByText(/some actions may have completed/i)).toBeInTheDocument();
+    await act(async () => { finishSend({ message_id: "retry-user", attempt_id: "retry-attempt" }); });
+  });
+
+  it.each([409, 503])("retains the interrupted row and permits retry after HTTP %i", async (status) => {
+    vi.spyOn(window, "confirm").mockReturnValue(true);
+    apiMock.sendMessage.mockRejectedValueOnce(new ApiError("try later", status));
+    renderSession();
+    fireEvent.click(await screen.findByRole("button", { name: /retry research/i }));
+    await waitFor(() => expect(apiMock.sendMessage).toHaveBeenCalledTimes(1));
+    await waitFor(() => expect(screen.getByText(/some actions may have completed/i)).toBeInTheDocument());
+    fireEvent.click(screen.getByRole("button", { name: /retry research/i }));
+    await waitFor(() => expect(apiMock.sendMessage).toHaveBeenCalledTimes(2));
+  });
+});
