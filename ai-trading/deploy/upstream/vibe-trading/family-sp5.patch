+def test_drain_rejects_new_send_without_persisting(tmp_path, monkeypatch):
+    """Pausing admission must not create a ghost user message or attempt."""
+
+    async def scenario():
+        service = _service(tmp_path, monkeypatch)
+        session = service.create_session(title="drain")
+        lease = service.start_deploy_drain()
+        with pytest.raises(RuntimeError, match="paused for deployment"):
+            await service.send_message(session.session_id, "new research")
+        assert service.store.get_messages(session.session_id) == []
+        assert service.store.list_attempts() == []
+        service.end_deploy_drain(lease)
+
+    asyncio.run(scenario())
+
+
+def test_drain_counts_already_admitted_work_until_its_reply_is_saved(tmp_path, monkeypatch):
+    """An in-flight attempt remains protected after new sends are paused."""
+
+    async def scenario():
+        service = _service(tmp_path, monkeypatch)
+        session = service.create_session(title="running")
+        gate = asyncio.Event()
+        _stub_agent(service, monkeypatch, {"status": "success", "content": "done"}, gate=gate)
+        await service.send_message(session.session_id, "research")
+        lease = service.start_deploy_drain()
+        assert service.deploy_drain_status(lease) == {
+            "active_chat": 1, "active_private_committees": 0,
+        }
+        gate.set()
+        for _ in range(100):
+            await asyncio.sleep(0.01)
+            if service.deploy_drain_status(lease)["active_chat"] == 0:
+                break
+        assert service.deploy_drain_status(lease)["active_chat"] == 0
+        assert service.store.get_messages(session.session_id)[-1].content == "done"
+        service.end_deploy_drain(lease)
+
+    asyncio.run(scenario())
+
+
+def test_drain_lease_rejects_other_holder_and_expires(tmp_path, monkeypatch):
+    """Only holder controls admission; a dead deploy cannot pause forever."""
+    service = _service(tmp_path, monkeypatch)
+    now = [100.0]
+    with monkeypatch.context() as clock_patch:
+        clock_patch.setattr("src.session.service.time.monotonic", lambda: now[0])
+        lease = service.start_deploy_drain()
+        with pytest.raises(ValueError):
+            service.renew_deploy_drain("wrong-holder")
+        with pytest.raises(ValueError):
+            service.end_deploy_drain("wrong-holder")
+        now[0] += 601
+        replacement = service.start_deploy_drain()
+        assert replacement != lease
+        service.end_deploy_drain(replacement)
+
+
+def test_new_process_does_not_inherit_prior_drain(tmp_path, monkeypatch):
+    """Process-local admission state resets when Vibe starts again."""
+    service = _service(tmp_path, monkeypatch)
+    service.start_deploy_drain()
+    replacement = _service(tmp_path, monkeypatch)
+    lease = replacement.start_deploy_drain()
+    assert replacement.deploy_drain_status(lease)["active_chat"] == 0
+    replacement.end_deploy_drain(lease)
