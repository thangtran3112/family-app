+
+import api_server
+from src.session.events import EventBus
+from src.session.service import SessionService
+from src.session.store import SessionStore
+
+
+@pytest.fixture
+def service(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> SessionService:
+    index = SimpleNamespace(index_session=lambda *args: None, index_message=lambda *args: None)
+    monkeypatch.setattr("src.session.service.get_shared_index", lambda: index)
+    instance = SessionService(SessionStore(tmp_path / "sessions"), EventBus(), tmp_path / "runs")
+    monkeypatch.setattr(api_server, "_get_session_service", lambda: instance)
+    monkeypatch.setenv("API_AUTH_KEY", "fake-deploy-key")
+    monkeypatch.setattr(api_server, "_API_KEY", "fake-deploy-key", raising=False)
+    return instance
+
+
+def test_local_authenticated_drain_returns_counts_without_run_details(service):
+    client = TestClient(api_server.app, client=("127.0.0.1", 50000))
+    headers = {"Authorization": "Bearer fake-deploy-key"}
+    started = client.post("/internal/deploy/drain", headers=headers)
+    assert started.status_code == 200
+    lease = started.json()["lease"]
+    assert set(started.json()) == {"lease", "active_chat", "active_private_committees"}
+    assert started.json()["active_chat"] == 0
+    authorized = {**headers, "X-Deploy-Lease": lease}
+    assert client.get("/internal/deploy/drain", headers=authorized).json()["active_chat"] == 0
+    assert client.post("/internal/deploy/drain/renew", headers=authorized).status_code == 200
+    assert client.delete("/internal/deploy/drain", headers=authorized).status_code == 200
+
+
+def test_remote_peer_with_valid_key_and_spoofed_forwarded_ip_cannot_drain(service):
+    remote = TestClient(api_server.app, client=("203.0.113.9", 50000))
+    response = remote.post("/internal/deploy/drain", headers={
+        "Authorization": "Bearer fake-deploy-key", "X-Forwarded-For": "127.0.0.1",
+    })
+    assert response.status_code == 403
+    lease = service.start_deploy_drain()
+    service.end_deploy_drain(lease)
+
+
+def test_configured_key_is_required_even_on_loopback(service):
+    client = TestClient(api_server.app, client=("127.0.0.1", 50000))
+    assert client.post("/internal/deploy/drain").status_code == 401
+    assert client.post("/internal/deploy/drain", headers={
+        "Authorization": "Bearer wrong-key",
+    }).status_code == 401
+
+
+def test_bad_lease_or_query_token_cannot_read_or_release_drain(service):
+    client = TestClient(api_server.app, client=("127.0.0.1", 50000))
+    headers = {"Authorization": "Bearer fake-deploy-key"}
+    lease = client.post("/internal/deploy/drain", headers=headers).json()["lease"]
+    assert client.get("/internal/deploy/drain?lease=" + lease, headers=headers).status_code != 200
+    assert client.delete("/internal/deploy/drain", headers={
+        **headers, "X-Deploy-Lease": "wrong-holder",
+    }).status_code in {403, 409}
+    assert client.get("/internal/deploy/drain", headers={
+        **headers, "X-Deploy-Lease": lease,
+    }).status_code == 200
+
+
+def test_failed_initial_status_releases_its_lease(service, monkeypatch):
+    client = TestClient(api_server.app, client=("127.0.0.1", 50000))
+    original = service.deploy_drain_status
+
+    def broken_status(_lease):
+        raise OSError("private store unreadable")
+
+    monkeypatch.setattr(service, "deploy_drain_status", broken_status)
+    response = client.post("/internal/deploy/drain", headers={
+        "Authorization": "Bearer fake-deploy-key",
+    })
+    assert response.status_code == 503
+    monkeypatch.setattr(service, "deploy_drain_status", original)
+    lease = service.start_deploy_drain()
+    service.end_deploy_drain(lease)
