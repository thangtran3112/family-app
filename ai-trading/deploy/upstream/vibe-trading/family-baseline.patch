+        ("allow_from", "list", False, False),
+        ("allow_channels", "list", False, False),
+        ("intents", "text", False, False),
+        ("group_policy", "text", False, False),
+        ("read_receipt_emoji", "text", False, False),
+        ("working_emoji", "text", False, False),
