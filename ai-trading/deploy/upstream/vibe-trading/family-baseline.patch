diff --git a/frontend/src/components/chat/ReasoningEffortSelect.tsx b/frontend/src/components/chat/ReasoningEffortSelect.tsx
new file mode 100644
index 00000000..af1782d9
--- /dev/null
+++ b/frontend/src/components/chat/ReasoningEffortSelect.tsx
@@ -0,0 +1,86 @@
+import { useEffect, useRef, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { api, type ReasoningEffortsResponse } from "@/lib/api";
+
+interface Props {
+  provider?: string;
+  modelName?: string;
+  /** Empty string means no override; use the server default. */
+  value: string;
+  onChange: (value: string) => void;
+  disabled?: boolean;
+  defaultEffort: string;
+}
+
+const EFFORT_LABEL_KEYS: Record<string, string> = {
+  none: "settings.reasoningEffortNone",
+  minimal: "settings.reasoningEffortMinimal",
+  low: "settings.reasoningEffortLow",
+  medium: "settings.reasoningEffortMedium",
+  high: "settings.reasoningEffortHigh",
+  xhigh: "settings.reasoningEffortXhigh",
+  max: "settings.reasoningEffortMax",
+};
+
+export function ReasoningEffortSelect({ provider, modelName, value, onChange, disabled, defaultEffort }: Props) {
+  const { t } = useTranslation();
+  const [result, setResult] = useState<{
+    key: string; response?: ReasoningEffortsResponse; failed?: boolean;
+  } | null>(null);
+  const key = `${provider ?? ""}\0${modelName ?? ""}`;
+  // Keep the latest value/callback without re-probing on every parent render.
+  const valueRef = useRef(value);
+  valueRef.current = value;
+  const onChangeRef = useRef(onChange);
+  onChangeRef.current = onChange;
+
+  useEffect(() => {
+    setResult(null);
+    if (!provider || !modelName) return;
+    let alive = true;
+    api.listReasoningEfforts({ provider, model_name: modelName })
+      .then((response) => {
+        if (!alive) return;
+        setResult({ key, response });
+        if (response.source === "provider" && valueRef.current && !response.efforts.includes(valueRef.current)) {
+          onChangeRef.current("");
+        }
+      })
+      .catch(() => {
+        if (alive) setResult({ key, failed: true });
+      });
+    return () => { alive = false; };
+  }, [provider, modelName, key]);
+
+  const current = result?.key === key ? result : null;
+  const effortLabel = (effort: string): string => {
+    if (!effort) return t("settings.providerDefault");
+    const label = EFFORT_LABEL_KEYS[effort];
+    return label ? t(label as never) : effort;
+  };
+  const defaultLabel = t("agent.reasoningEffortDefault", { level: effortLabel(defaultEffort) });
+  if (current?.failed || (current?.response?.source === "provider" && current.response.efforts.length === 0)) {
+    return (
+      <span className="ml-auto inline-flex shrink-0 items-center gap-1.5 rounded-full border border-border/70 bg-muted/35 px-2 py-0.5 text-[10px] text-muted-foreground">
+        {t("agent.reasoningStrength")}: {defaultLabel}
+      </span>
+    );
+  }
+
+  return (
+    <select
+      aria-label={t("agent.reasoningStrength")}
+      aria-description={t("agent.reasoningEffortHint")}
+      title={t("agent.reasoningEffortHint")}
+      value={value}
+      disabled={disabled || !current?.response}
+      onChange={(event) => onChange(event.target.value)}
+      className="ml-auto min-h-11 max-w-[11rem] shrink-0 rounded-full border border-border/70 bg-muted/35 px-2 text-xs text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-70"
+    >
+      <option value="">{defaultLabel}</option>
+      {current?.response?.efforts.map((effort) => (
+        <option key={effort} value={effort}>{effortLabel(effort)}</option>
+      ))}
+    </select>
+  );
+}
