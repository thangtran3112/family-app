@@ -0,0 +1,675 @@
+"""Run-scoped, fail-closed US-stock recommendation proof and rendering."""
+
+from __future__ import annotations
+
+import json
+import hashlib
+import os
+import re
+import threading
+import urllib.error
+import urllib.request
+import uuid
+from datetime import date, datetime, timezone
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
+from pathlib import Path
+from typing import Any, Callable
+
+from backtest.loaders.yahoo_client import map_symbol
+
+_US_TICKER = re.compile(r"[A-Z]{1,5}(?:\.[A-Z])?\.US\Z")
+_RUN_ID = re.compile(r"swarm-\d{8}-\d{6}-[0-9a-f]{8}\Z")
+_BRIDGE_ORIGIN = "http://vibe-consensus:8000"
+_COUNT_NAMES = ("strong_buy", "buy", "hold", "sell", "strong_sell")
+_TASKS = {"task-bull": "bull_advocate", "task-bear": "bear_advocate",
+          "task-risk": "risk_officer", "task-decision": "portfolio_manager"}
+
+
+def needs_committee(user_message: str, history: list[dict] | None) -> bool:
+    """Detect a request for our own verdict, not a quote of third-party ratings."""
+    text = re.sub(r"\bbuy[- ]and[- ]hold\b", "passive benchmark", user_message.lower())
+    direct = bool(re.search(r"\b(should i|would you|do you recommend|your (?:own |personal )?(?:view|target|rating|recommendation)|give (?:me )?(?:your|an own) (?:target|recommendation)|buy|sell|hold)\b", text))
+    direct |= bool(re.search(r"\b(?:recommend|(?:give|provide|estimate|set)\b.{0,40}\b(?:price target|target price|target))\b", text))
+    direct |= bool(re.search(r"(我应该|要不要|你的目标价|你建议|买入|卖出|目标价)", text))
+    direct |= bool(re.search(r"(هل أشتري|هل أبيع|ما السعر المستهدف|توصيتك)", text))
+    attributed = bool(re.search(r"\b(yahoo|analysts?|consensus|third.party)\b", text))
+    attributed |= bool(re.search(r"分析师|券商|华尔街|المحللين", text))
+    personal = bool(re.search(r"\b(should i|would you|do you|your|you recommend|buy now|sell now)\b", text))
+    personal |= bool(re.search(r"我|你|هل أشتري|هل أبيع|توصيتك", text))
+    return direct and (not attributed or personal)
+
+
+class _NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        return None
+
+
+def fetch_counts(ticker: str, token: str, base_url: str, opener: Any = None) -> dict:
+    """Fetch a fixed-host, header-authenticated count envelope, never a URL from text."""
+    if not token:
+        return {"status": "unavailable", "reason": "not_configured"}
+    if base_url != _BRIDGE_ORIGIN or not _US_TICKER.fullmatch(ticker):
+        return {"status": "unavailable", "reason": "bad_request"}
+    request = urllib.request.Request(
+        f"{_BRIDGE_ORIGIN}/v1/recommendations/{ticker}", headers={"X-API-Key": token}
+    )
+    send = opener or urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect()).open
+    try:
+        with send(request, timeout=30) as response:
+            payload = response.read(4097)
+        if len(payload) > 4096:
+            return {"status": "unavailable", "reason": "upstream"}
+        result = json.loads(payload)
+    except urllib.error.HTTPError as error:
+        if error.code == 503:
+            try:
+                result = json.loads(error.read(4097))
+                if result.get("status") == "unavailable" and result.get("reason") in {
+                    "not_configured", "stale", "no_data", "upstream"
+                }:
+                    return {"status": "unavailable", "reason": result["reason"]}
+            except (ValueError, AttributeError, TypeError):
+                pass
+        return {"status": "unavailable", "reason": "upstream"}
+    except (OSError, ValueError, TypeError):
+        return {"status": "unavailable", "reason": "upstream"}
+    if (not isinstance(result, dict) or result.get("status") != "ok"
+            or result.get("symbol") != ticker or result.get("provider") != "finnhub"
+            or not _counts_valid(result)):
+        return {"status": "unavailable", "reason": "no_data"}
+    return {name: result.get(name) for name in
+            ("status", "symbol", "provider", "period", "retrieved_at", *_COUNT_NAMES)}
+
+
+def _counts_valid(value: dict) -> bool:
+    return (all(type(value.get(name)) is int and value[name] >= 0 for name in _COUNT_NAMES)
+            and sum(value[name] for name in _COUNT_NAMES) > 0)
+
+
+def _when(value: Any) -> datetime | None:
+    try:
+        result = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
+        return result.astimezone(timezone.utc) if result.tzinfo else None
+    except (ValueError, TypeError, OverflowError):
+        return None
+
+
+def _fresh(timestamp: Any, now: datetime, days: int) -> bool:
+    when = _when(timestamp)
+    return when is not None and 0 <= (now - when).total_seconds() <= days * 86400
+
+
+def format_consensus_context(bridge: dict, yahoo: dict, *, sec_fact: dict | None = None,
+                             quote_fact: dict | None = None) -> str:
+    """Give the chair exact checked counts, source windows and evidence IDs."""
+    def counts(value):
+        return "/".join(str(value[name]) for name in _COUNT_NAMES)
+
+    ticker, period = bridge["symbol"], bridge["period"]
+    context = (f"Finnhub {ticker} {period}: {counts(bridge)} [bridge:{ticker}:{period}]; "
+               f"Yahoo {yahoo['symbol']} 0m: {counts(yahoo)} [{yahoo['call_id']}]")
+    if (isinstance(sec_fact, dict) and isinstance(quote_fact, dict)
+            and all(sec_fact.get(key) is not None for key in ("value", "period_end", "accession", "filed", "call_id"))
+            and all(quote_fact.get(key) is not None for key in ("price", "as_of"))):
+        context += (f"; SEC {ticker} diluted EPS {sec_fact['value']} USD/shares "
+                    f"period {sec_fact['period_end']} accession {sec_fact['accession']} "
+                    f"filed {sec_fact['filed']} [{sec_fact['call_id']}]; "
+                    f"Yahoo quote ${quote_fact['price']} USD as-of {quote_fact['as_of']}")
+    return context
+
+
+def valuation_target(record: dict, sec_fact: dict, quote_fact: dict, split_events: dict) -> Decimal | None:
+    """Recompute SEC-backed 12-month EPS×P/E on a proven same-share USD basis."""
+    if any(record.get(k) != sec_fact.get(k) for k in ("accession", "period_end", "symbol")):
+        return None
+    if (record.get("unit") != "USD/share" or sec_fact.get("unit") != "USD/shares"
+            or sec_fact.get("form") != "10-K" or type(sec_fact.get("period_days")) is not int
+            or not 330 <= sec_fact["period_days"] <= 400 or record.get("horizon_months") != 12
+            or quote_fact.get("symbol") != record.get("symbol")
+            or quote_fact.get("source") != "yahoo" or quote_fact.get("currency") != "USD"
+            or record.get("quote_as_of") != quote_fact.get("as_of")
+            or split_events.get("status") != "ok" or split_events.get("symbol") != record.get("symbol")
+            or split_events.get("start") != record.get("period_end")
+            or split_events.get("events") != []):
+        return None
+    try:
+        eps = Decimal(str(sec_fact["value"]))
+        claimed_eps = Decimal(str(record["eps"]))
+        growth = Decimal(str(record["growth"]))
+        multiple = Decimal(str(record["multiple"]))
+        factor = Decimal(str(record["split_factor"]))
+        price = Decimal(str(quote_fact["price"]))
+        quote_claim = Decimal(str(record["quote_price"]))
+        low = Decimal(str(record["confidence_low"]))
+        high = Decimal(str(record["confidence_high"]))
+        proposed = Decimal(str(record["candidate_target"]))
+        filed = date.fromisoformat(sec_fact["filed"])
+        period_end = date.fromisoformat(record["period_end"])
+        quote_at = _when(record["quote_as_of"])
+        retrieved_at = _when(quote_fact["retrieved_at"])
+    except (KeyError, ValueError, InvalidOperation, TypeError):
+        return None
+    if (quote_at is None or retrieved_at is None or not 0 <= (retrieved_at - quote_at).total_seconds() <= 5 * 86400
+            or not all(x.is_finite() for x in
+                                   (eps, claimed_eps, growth, multiple, factor, price, quote_claim, low, high, proposed))
+            or eps <= 0 or claimed_eps != eps or price <= 0 or quote_claim != price
+            or not Decimal("-0.5") <= growth <= 1
+            or not 1 <= multiple <= 100 or factor != 1
+            or not period_end < filed <= quote_at.date()
+            or (quote_at.date() - period_end).days > 450
+            or split_events.get("end") != quote_at.date().isoformat()
+            or not 0 < low <= proposed <= high):
+        return None
+    target = (eps * (1 + growth) * multiple).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+    return target if abs(target - proposed) <= Decimal("0.01") else None
+
+
+def verify_committee(
+    run_id: str, ticker: str, swarm_root: Path, ledger: Any,
+    bridge: dict, yahoo: dict, *, now: datetime,
+    sec_fact: dict | None = None, quote_fact: dict | None = None,
+    split_events: dict | None = None,
+) -> dict:
+    """Approve only a completed, bound, evidenced chair disposition."""
+    denied = {"status": "analysis_only", "reason": "unverified_committee"}
+    if not _RUN_ID.fullmatch(run_id) or not _US_TICKER.fullmatch(ticker):
+        return denied
+    root = Path(swarm_root).resolve()
+    path = (root / run_id / "run.json").resolve()
+    if not path.is_relative_to(root) or not path.is_file() or path.stat().st_size > 2_000_000:
+        return denied
+    try:
+        run = json.loads(path.read_text())
+        report = run.get("final_report")
+        if (run.get("id") != run_id or run.get("preset_name") != "investment_committee"
+                or run.get("status") != "completed" or not isinstance(report, str)
+                or not report.strip() or "INCOMPLETE — ANALYSIS ONLY" in report.upper()
+                or not _fresh(run.get("completed_at"), now, 1)):
+            return denied
+        user_vars = run["user_vars"]
+        if (user_vars.get("target") != ticker or user_vars.get("market") != "US"
+                or user_vars.get("committee_run_id") != run_id or ledger is None
+                or user_vars.get("parent_run_id") != Path(ledger.run_dir).name):
+            return denied
+        tasks = run["tasks"]
+        if (not isinstance(tasks, list) or len(tasks) != len(_TASKS)
+                or any(t.get("agent_id") != _TASKS.get(t.get("id"))
+                       or t.get("status") != "completed" or not (t.get("summary") or "").strip()
+                       for t in tasks)):
+            return denied
+        match = re.search(r"<family-us-decision>(.*?)</family-us-decision>\s*\Z", report, re.S)
+        if not match or report.count("<family-us-decision>") != 1 or len(match.group(1).encode()) > 8192:
+            return denied
+        decision = json.loads(match.group(1))
+        if (not isinstance(decision, dict) or decision.get("status") != "approved"
+                or decision.get("symbol") != ticker or decision.get("run_id") != run_id
+                or decision.get("verdict") not in {"buy", "sell", "hold"}
+                or not _fresh(decision.get("as_of"), now, 1)
+                or set(decision.get("reviewed_tasks", [])) != set(_TASKS)
+                or len(decision["reviewed_tasks"]) != len(_TASKS)):
+            return denied
+        rationale = decision.get("review_rationale")
+        if (not isinstance(rationale, str) or len(rationale.strip()) < 80
+                or not all(word in rationale.lower() for word in ("bull", "bear", "risk"))):
+            return denied
+        period = date.fromisoformat(bridge["period"])
+        if (bridge.get("status") != "ok" or bridge.get("symbol") != ticker
+                or bridge.get("provider") != "finnhub" or not _counts_valid(bridge)
+                or not 0 <= (now.date() - period).days <= 45
+                or not _fresh(bridge.get("retrieved_at"), now, 5)
+                or yahoo.get("status") != "ok" or yahoo.get("symbol") != ticker
+                or yahoo.get("source") != "yahoo" or yahoo.get("period") != "0m"
+                or not _counts_valid(yahoo) or not _fresh(yahoo.get("retrieved_at"), now, 5)):
+            return denied
+        base_context = format_consensus_context(bridge, yahoo)
+        full_context = (format_consensus_context(bridge, yahoo, sec_fact=sec_fact, quote_fact=quote_fact)
+                        if sec_fact and quote_fact else base_context)
+        if user_vars.get("consensus_context") not in {base_context, full_context}:
+            return denied
+        # A model can write in its run directory; trust only the live ledger's
+        # records, never a JSON artifact it may have overwritten.
+        evidence = [vars(item) for item in ledger._evidence]
+        yahoo_call = yahoo.get("call_id")
+        if not isinstance(yahoo_call, str) or not any(
+            isinstance(e, dict) and e.get("call_id") == yahoo_call
+            and e.get("tool") == "get_stock_profile" and e.get("symbol") == ticker
+            and e.get("source") == "yahoo" and e.get("status") == "observed"
+            and "recommendation_trend" in str(e.get("field"))
+            and type(e.get("value")) in (int, float) for e in evidence
+        ):
+            return denied
+        bridge_id = f"bridge:{ticker}:{period.isoformat()}"
+        ids = decision.get("evidence_ids")
+        observed_calls = {
+            e["call_id"] for e in evidence
+            if isinstance(e, dict) and e.get("status") == "observed"
+            and e.get("symbol") == ticker and e.get("tool") in {"get_stock_profile", "get_sec_filings"}
+            and isinstance(e.get("call_id"), str)
+        }
+        allowed = set(_TASKS) | {yahoo_call, bridge_id} | observed_calls
+        if (not isinstance(ids, list) or any(not isinstance(i, str) for i in ids)
+                or not {"task-bull", "task-bear", "task-risk", yahoo_call, bridge_id}.issubset(ids)
+                or not set(ids).issubset(allowed)):
+            return denied
+        def direction(value):
+            up = value["strong_buy"] + value["buy"]
+            down = value["sell"] + value["strong_sell"]
+            return (up > down) - (up < down)
+        if direction(bridge) != direction(yahoo):
+            disagreement = decision.get("disagreement_rationale")
+            if (not isinstance(disagreement, str) or not all(
+                token in disagreement.lower() for token in ("finnhub", "yahoo", period.isoformat(), "0m")
+            )):
+                return denied
+        proof = {"status": "approved", "symbol": ticker, "verdict": decision["verdict"],
+                 "target": None, "period": period.isoformat(), "evidence_ids": ids}
+        record = decision.get("valuation")
+        if (isinstance(record, dict) and sec_fact and quote_fact and split_events
+                and user_vars.get("consensus_context") == full_context):
+            # Target requires actual filed SEC evidence, not a chair's claim.
+            sec_call = sec_fact.get("call_id")
+            if (sec_call in ids and sec_fact.get("latest") is True
+                    and _fresh(quote_fact.get("retrieved_at"), now, 5)
+                    and _fresh(quote_fact.get("as_of"), now, 5)
+                    and any(e.get("call_id") == sec_call and e.get("tool") == "get_sec_filings"
+                            and e.get("status") == "observed" and e.get("symbol") == ticker
+                            and e.get("source") == "sec_edgar"
+                            and "metric" in str(e.get("field"))
+                            and type(e.get("value")) in (int, float)
+                            and str(e["value"]) == str(sec_fact.get("value")) for e in evidence)):
+                target = valuation_target(record, sec_fact, quote_fact, split_events)
+                if target is not None:
+                    proof["target"] = str(target)
+                    proof["valuation"] = {
+                        "eps": str(sec_fact["value"]), "period_end": sec_fact["period_end"],
+                        "accession": sec_fact["accession"], "unit": "USD/share",
+                        "quote_price": str(record["quote_price"]),
+                        "quote_as_of": quote_fact["as_of"], "horizon_months": 12,
+                        **{key: record[key] for key in
+                           ("growth", "multiple", "confidence_low", "confidence_high")},
+                    }
+        return proof
+    except (OSError, ValueError, KeyError, TypeError, AttributeError, OverflowError):
+        return denied
+
+
+def render_recommendation(proof: dict) -> str:
+    """Issue only typed values the server checked; never copy raw chair prose."""
+    if proof.get("status") != "approved" or proof.get("verdict") not in {"buy", "sell", "hold"}:
+        return ""
+    verdict = proof["verdict"].capitalize()
+    text = (f"Committee-reviewed: {verdict} {proof['symbol']}. "
+            f"Independent rating counts: Finnhub ({proof['period']}) and Yahoo (current 0m).")
+    if proof.get("target") is not None:
+        value = proof["valuation"]
+        text += (f" Own 12-month target: ${proof['target']} USD/share "
+                 f"(SEC diluted EPS ${value['eps']} USD/share for period ended {value['period_end']}, "
+                 f"accession {value['accession']}; quote ${value['quote_price']} USD as of {value['quote_as_of']}; "
+                 f"assumed growth {value['growth']}, "
+                 f"assumed P/E {value['multiple']}; confidence range "
+                 f"${value['confidence_low']}–${value['confidence_high']}).")
+    return text + " No order was placed."
