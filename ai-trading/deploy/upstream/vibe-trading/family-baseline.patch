+def test_bridge_client_rejects_user_url_and_only_sends_key_as_header():
+    requests = []
+
+    class Response:
+        status = 200
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *args):
+            return False
+
+        def read(self, limit):
+            return json.dumps({"status": "ok", "symbol": "AAPL.US", "provider": "finnhub",
+                               "period": "2026-09-01", "retrieved_at": "2026-10-12T00:00:00Z",
+                               "strong_buy": 12, "buy": 22, "hold": 15, "sell": 3, "strong_sell": 1}).encode()
+
+    def opener(request, *, timeout):
+        requests.append((request, timeout))
+        return Response()
+
+    result = fetch_counts("AAPL.US", "fake-key", "http://vibe-consensus:8000", opener=opener)
+    assert result["period"] == "2026-09-01"
+    assert len(requests) == 1 and requests[0][1] <= 30
+    assert requests[0][0].full_url == "http://vibe-consensus:8000/v1/recommendations/AAPL.US"
+    assert dict(requests[0][0].header_items())["X-api-key"] == "fake-key"
+    assert fetch_counts("AAPL.US", "fake-key", "http://attacker.invalid", opener=opener)["status"] == "unavailable"
+    assert len(requests) == 1
