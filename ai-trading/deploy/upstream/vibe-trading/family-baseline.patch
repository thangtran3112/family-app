+    if not _US_SPLIT_SYMBOL.fullmatch(symbol) or not start < end:
+        return unavailable
+    mapped = map_symbol(symbol)
+    try:
+        payload = throttled_get_json(
+            f"{_CHART_BASE}/{mapped}", host_key=HOST_KEY, min_interval=_min_interval(),
+            params={
+                "interval": "1d", "events": "splits",
+                "period1": int(datetime.combine(start, time.min, timezone.utc).timestamp()),
+                "period2": int(datetime.combine(end + timedelta(days=1), time.min, timezone.utc).timestamp()),
+            },
+        )
+        chart = payload["chart"]
+        if chart.get("error") or not isinstance(chart["result"], list) or len(chart["result"]) != 1:
+            return unavailable
+        result = chart["result"][0]
+        meta = result["meta"]
+        stamps = result["timestamp"]
+        if (meta.get("symbol") != mapped or meta.get("currency") != "USD"
+                or not isinstance(stamps, list) or not stamps
+                or any(type(stamp) is not int for stamp in stamps)):
+            return unavailable
+        first = datetime.fromtimestamp(min(stamps), timezone.utc).date()
+        last = datetime.fromtimestamp(max(stamps), timezone.utc).date()
+        if first > start + timedelta(days=7) or last < end - timedelta(days=7):
+            return unavailable
+        events = result.get("events") or {}
+        if not isinstance(events, dict):
+            return unavailable
+        splits = events.get("splits", {})
+        if not isinstance(splits, dict) or len(splits) > 100:
+            return unavailable
+        normalized = []
+        for row in splits.values():
+            if not isinstance(row, dict) or type(row.get("date")) is not int:
+                return unavailable
+            day = datetime.fromtimestamp(row["date"], timezone.utc).date()
+            ratio = row.get("splitRatio")
+            if not isinstance(ratio, str) or not ratio:
+                return unavailable
+            if start < day <= end:
+                normalized.append({"date": day.isoformat(), "ratio": ratio})
+        return {"status": "ok", "symbol": symbol, "start": start.isoformat(),
+                "end": end.isoformat(), "events": normalized}
+    except (KeyError, TypeError, ValueError, OverflowError, requests.RequestException):
+        return unavailable
+
+
