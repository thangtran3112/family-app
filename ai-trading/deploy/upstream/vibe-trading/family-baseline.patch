+
+    gate = CommitteeGate("Should I buy AAPL.US?", None,
+                         bridge_fetcher=lambda *_: {"status": "unavailable", "reason": "not_configured"})
+    timer = threading.Timer(0.1, cancelled.set)
+    timer.start()
+    started = time.monotonic()
+    try:
+        proof = gate.orchestrate(SlowRegistry(), "Should I buy AAPL.US?", "AAPL.US",
+                                 SimpleNamespace(run_dir=tmp_path, _evidence=[]), tmp_path,
