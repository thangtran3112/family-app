+
+def test_update_llm_settings_rejects_effort_the_model_does_not_accept(
+    client: TestClient, tmp_path: Path, monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _fake_openai(monkeypatch, 400, SOL_MESSAGE)
+    payload = {
+        "provider": "openai",
+        "model_name": "gpt-6.1-sol",
+        "base_url": "https://api.openai.com/v1",
+        "api_key": "sk-test",
+        "timeout_seconds": 120,
+        "max_retries": 2,
+        "reasoning_effort": "max",
+    }
+
+    rejected = client.put("/settings/llm", json=payload)
+
+    assert rejected.status_code == 400
+    assert "gpt-6.1-sol" in rejected.json()["detail"]
+    assert "low, medium, high, xhigh" in rejected.json()["detail"]
+    assert not (tmp_path / ".env").exists()  # nothing persisted
+
+    accepted = client.put("/settings/llm", json={**payload, "reasoning_effort": "xhigh"})
+
+    assert accepted.status_code == 200
+    assert accepted.json()["reasoning_effort"] == "xhigh"
+    assert "LANGCHAIN_REASONING_EFFORT=xhigh" in (tmp_path / ".env").read_text(encoding="utf-8")
+
+
+def test_update_llm_settings_explains_models_without_a_reasoning_setting(
+    client: TestClient, tmp_path: Path, monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _fake_openai(monkeypatch, 400, "Unrecognized request argument supplied: reasoning_effort")
+
+    response = client.put(
+        "/settings/llm",
+        json={
+            "provider": "openai",
+            "model_name": "gpt-4.1",
+            "base_url": "https://api.openai.com/v1",
+            "api_key": "sk-test",
+            "reasoning_effort": "low",
