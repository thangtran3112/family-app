+
+def test_update_llm_settings_lists_valid_efforts_weakest_first(client: TestClient) -> None:
+    response = client.put(
+        "/settings/llm",
+        json={"provider": "openai", "model_name": "gpt-6.1-sol", "reasoning_effort": "turbo"},
+    )
+
+    assert response.status_code == 400
+    assert "none, minimal, low, medium, high, xhigh, max" in response.json()["detail"]
