new file mode 100644
index 00000000..eb418132
--- /dev/null
+++ b/frontend/src/pages/__tests__/SettingsReasoningEfforts.test.tsx
@@ -0,0 +1,223 @@
+import { cleanup, fireEvent, render, screen, waitFor, within } from "@testing-library/react";
+import i18n from "@/i18n";
+import { Settings } from "../Settings";
+
+const apiMock = vi.hoisted(() => ({
+  getLLMSettings: vi.fn(),
+  getDataSourceSettings: vi.fn(),
+  listReasoningEfforts: vi.fn(),
+  getChannelStatus: vi.fn(),
+  getChannelsConfig: vi.fn(),
+  listLLMModels: vi.fn(),
+  updateLLMSettings: vi.fn(),
+}));
+const toastMock = vi.hoisted(() => ({ success: vi.fn(), info: vi.fn(), error: vi.fn() }));
+
+vi.mock("@/lib/api", async () => {
+  const actual = await vi.importActual<typeof import("@/lib/api")>("@/lib/api");
+  return { ...actual, api: apiMock, isAuthRequiredError: vi.fn(() => false) };
+});
+vi.mock("@/lib/apiAuth", () => ({
+  authHeaders: vi.fn(() => ({})),
+  getApiAuthKey: vi.fn(() => ""),
+  setApiAuthKey: vi.fn(),
+}));
+vi.mock("sonner", () => ({ toast: toastMock }));
+
+const SOL = ["low", "medium", "high", "xhigh"];
+const GPT55 = ["none", "low", "medium", "high", "xhigh"];
+
+function llmSettings(overrides: Record<string, unknown> = {}) {
+  return {
+    provider: "openai",
+    model_name: "gpt-6.1-sol",
+    base_url: "https://api.openai.com/v1",
+    api_key_env: "OPENAI_API_KEY",
+    api_key_configured: true,
+    api_key_required: true,
+    timeout_seconds: 120,
+    max_retries: 2,
+    reasoning_effort: "medium",
+    sse_timeout_seconds: 300,
+    env_path: "agent/.env",
+    providers: [
+      {
+        name: "openai",
+        label: "OpenAI",
+        api_key_env: "OPENAI_API_KEY",
+        base_url_env: "OPENAI_BASE_URL",
+        default_model: "gpt-6.1-sol",
+        default_base_url: "https://api.openai.com/v1",
+        api_key_required: true,
+        auth_type: "api_key",
+      },
+    ],
+    ...overrides,
+  };
+}
+
+function efforts(model: string, list: string[], source: "provider" | "default" = "provider") {
+  return { provider: "openai", model_name: model, efforts: list, source };
+}
+
+/** Answer each probe from a model -> list table, like the real backend would. */
+function answerFrom(table: Record<string, string[]>) {
+  apiMock.listReasoningEfforts.mockImplementation(async (request: { model_name: string }) =>
+    efforts(request.model_name, table[request.model_name] ?? ["low", "medium", "high"], request.model_name in table ? "provider" : "default"),
+  );
+}
+
+const picker = () => screen.getByLabelText(/^Reasoning Effort/) as HTMLSelectElement;
+const optionValues = () => within(picker()).getAllByRole("option").map((option) => (option as HTMLOptionElement).value);
+const waitForOptions = (expected: string[]) => waitFor(() => expect(optionValues()).toEqual(expected), { timeout: 3000 });
+const setModel = (name: string) =>
+  fireEvent.change(screen.getByRole("combobox", { name: "Model" }), { target: { value: name } });
+
+describe("Settings reasoning effort picker", () => {
+  beforeEach(async () => {
+    await i18n.changeLanguage("en");
+    window.localStorage.clear();
+    Object.values(apiMock).forEach((mock) => mock.mockReset());
+    Object.values(toastMock).forEach((mock) => mock.mockReset());
+    apiMock.getLLMSettings.mockResolvedValue(llmSettings());
+    apiMock.getDataSourceSettings.mockResolvedValue({ env_path: "agent/.env", source_orders: [] });
+    apiMock.getChannelStatus.mockResolvedValue({ running: false, inbound_queue: 0, outbound_queue: 0, session_count: 0, channels: {} });
+    apiMock.getChannelsConfig.mockResolvedValue({ config_path: "agent/agent.json", writable: true, runtime_running: false, channels: {} });
+    apiMock.listLLMModels.mockResolvedValue({ provider: "openai", models: [], source: "default" });
+    answerFrom({ "gpt-6.1-sol": SOL, "gpt-5.5": GPT55, "gpt-4.1": [] });
+  });
+
+  afterEach(() => cleanup());
+
+  it("offers exactly the efforts the selected model supports - Sol has no Max and no None", async () => {
+    render(<Settings />);
+
+    await waitForOptions(["", ...SOL]);
+    expect(optionValues()).not.toContain("max");
+    expect(optionValues()).not.toContain("none");
+    expect(picker().value).toBe("medium");
+    expect(apiMock.listReasoningEfforts).toHaveBeenCalledWith(
+      expect.objectContaining({ provider: "openai", model_name: "gpt-6.1-sol" }),
+    );
+  });
+
+  it("labels the newer levels instead of showing raw ids", async () => {
+    render(<Settings />);
+
+    await waitForOptions(["", ...SOL]);
+    expect(within(picker()).getByRole("option", { name: "Extra high" })).toBeInTheDocument();
+  });
+
+  it("reloads the list when the model changes", async () => {
+    render(<Settings />);
+    await waitForOptions(["", ...SOL]);
+
+    setModel("gpt-5.5");
+
+    await waitForOptions(["", ...GPT55]);
+    expect(within(picker()).getByRole("option", { name: "None (explicit)" })).toBeInTheDocument();
+  });
+
+  it("resets a level the new model rejects to the provider default and says so", async () => {
+    apiMock.getLLMSettings.mockResolvedValue(llmSettings({ model_name: "gpt-5.5", reasoning_effort: "none" }));
+    render(<Settings />);
+    await waitForOptions(["", ...GPT55]);
+    expect(picker().value).toBe("none");
+
+    setModel("gpt-6.1-sol");
+
+    await waitFor(() => expect(picker().value).toBe(""), { timeout: 3000 });
+    expect(toastMock.info).toHaveBeenCalledTimes(1);
+    expect(String(toastMock.info.mock.calls[0][0])).toContain("gpt-6.1-sol");
+    expect(String(toastMock.info.mock.calls[0][0])).toContain("none");
+  });
+
+  it("repairs a saved level the model does not support as soon as the page loads", async () => {
+    apiMock.getLLMSettings.mockResolvedValue(llmSettings({ reasoning_effort: "max" }));
+    render(<Settings />);
+
+    await waitFor(() => expect(picker().value).toBe(""), { timeout: 3000 });
+    expect(optionValues()).not.toContain("max");
+    expect(toastMock.info).toHaveBeenCalledTimes(1);
+  });
+
+  it("never shows the previous model's list while the new one is loading", async () => {
+    render(<Settings />);
+    await waitForOptions(["", ...SOL]);
+    let release: (value: ReturnType<typeof efforts>) => void = () => undefined;
+    apiMock.listReasoningEfforts.mockImplementation(
+      () => new Promise((resolve) => { release = resolve; }),
+    );
+    const callsBefore = apiMock.listReasoningEfforts.mock.calls.length;
+
+    setModel("gpt-5.5");
+
+    // The request is debounced; the old list must already be gone while it is pending.
+    expect(picker()).toBeDisabled();
+    expect(optionValues()).not.toContain("xhigh");
+    expect(screen.getByText("Checking the levels this model supports…")).toBeInTheDocument();
+    await waitFor(() => expect(apiMock.listReasoningEfforts).toHaveBeenCalledTimes(callsBefore + 1), { timeout: 3000 });
+    expect(picker()).toBeDisabled();
+    release(efforts("gpt-5.5", GPT55));
+    await waitForOptions(["", ...GPT55]);
+    expect(picker()).toBeEnabled();
+  });
+
+  it("disables the picker for a model with no reasoning control", async () => {
+    apiMock.getLLMSettings.mockResolvedValue(llmSettings({ model_name: "gpt-4.1", reasoning_effort: "" }));
+    render(<Settings />);
+
+    await waitFor(() => expect(picker()).toBeDisabled(), { timeout: 3000 });
+    await waitFor(() => expect(screen.getByText("This model has no reasoning-effort setting.")).toBeInTheDocument());
+    expect(optionValues()).toEqual([""]);
+  });
+
+  it("keeps the conservative list when the lookup itself fails", async () => {
+    apiMock.getLLMSettings.mockResolvedValue(llmSettings({ reasoning_effort: "" }));
+    apiMock.listReasoningEfforts.mockRejectedValue(new Error("network down"));
+    render(<Settings />);
+
+    await waitForOptions(["", "low", "medium", "high"]);
+    expect(picker()).toBeEnabled();
+    expect(toastMock.info).not.toHaveBeenCalled();
+  });
+
+  it("does not drop a known list or the user's choice when a later lookup is inconclusive", async () => {
+    render(<Settings />);
+    await waitForOptions(["", ...SOL]);
+    apiMock.listReasoningEfforts.mockResolvedValue(efforts("gpt-6.1-sol", ["low", "medium", "high"], "default"));
+
+    fireEvent.change(screen.getByPlaceholderText(/configured|key/i), { target: { value: "sk-partial" } });
+
+    await waitFor(() => expect(apiMock.listReasoningEfforts).toHaveBeenLastCalledWith(
+      expect.objectContaining({ api_key: "sk-partial" }),
+    ), { timeout: 3000 });
+    expect(optionValues()).toEqual(["", ...SOL]);
+    expect(picker().value).toBe("medium");
+    expect(toastMock.info).not.toHaveBeenCalled();
+  });
+
+  it("saves the chosen level and sends no temperature", async () => {
+    apiMock.updateLLMSettings.mockResolvedValue(llmSettings({ reasoning_effort: "xhigh" }));
+    render(<Settings />);
+    await waitForOptions(["", ...SOL]);
+
+    fireEvent.change(picker(), { target: { value: "xhigh" } });
+    fireEvent.submit(picker().closest("form") as HTMLFormElement);
+
+    await waitFor(() => expect(apiMock.updateLLMSettings).toHaveBeenCalledTimes(1));
+    const sent = apiMock.updateLLMSettings.mock.calls[0][0];
+    expect(sent.reasoning_effort).toBe("xhigh");
+    expect(sent.model_name).toBe("gpt-6.1-sol");
+    expect(sent).not.toHaveProperty("temperature");
+  });
+
+  it("no longer shows temperature, QVeris or the China data-source credentials", async () => {
+    render(<Settings />);
+    await waitForOptions(["", ...SOL]);
+
+    for (const gone of [/temperature/i, /qveris/i, /tushare/i, /gildata/i, /baostock/i, /data source settings/i]) {
+      expect(screen.queryByText(gone)).not.toBeInTheDocument();
+    }
+  });
+});
