+
+    class _FakeChatLLM:
+        def __init__(self, **kwargs):
+            seen.append(kwargs)
+
+        def close(self) -> None:
+            pass
+
+    monkeypatch.setattr("src.swarm.worker.ChatLLM", _FakeChatLLM)
+    monkeypatch.setattr(
+        "src.swarm.worker._run_worker_impl",
+        lambda **kwargs: WorkerResult(status="completed", summary="ok"),
+    )
+    run_worker(run.agents[0], run.tasks[0], {}, run.user_vars, tmp_path, reasoning_effort="xhigh")
+
+    assert seen == [{"model_name": run.agents[0].model_name, "reasoning_effort": "xhigh"}]
