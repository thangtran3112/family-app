+import { render, screen, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { ReasoningEffortSelect } from "../ReasoningEffortSelect";
+import { api } from "@/lib/api";
+
+vi.mock("@/lib/api", () => ({ api: { listReasoningEfforts: vi.fn() } }));
+const listReasoningEfforts = vi.mocked(api.listReasoningEfforts);
+
+afterEach(() => { vi.resetAllMocks(); });
+
+describe("ReasoningEffortSelect", () => {
+  it("lists only the levels the model-specific probe accepted", async () => {
+    listReasoningEfforts.mockResolvedValue({
+      provider: "openai", model_name: "o3", efforts: ["low", "medium", "high"], source: "provider",
+    });
+    render(<ReasoningEffortSelect provider="openai" modelName="o3" value="" onChange={() => {}} defaultEffort="xhigh" />);
+
+    await waitFor(() => expect(screen.getAllByRole("option")).toHaveLength(4));
+    expect(screen.queryByText("Extra high")).not.toBeInTheDocument();
+    expect(screen.getByText("Default (Extra high)")).toBeInTheDocument();
+    expect(screen.getByText("Low")).toBeInTheDocument();
+    expect(screen.getByText("High")).toBeInTheDocument();
+  });
+
+  it("selecting a level calls onChange with that value", async () => {
+    listReasoningEfforts.mockResolvedValue({
+      provider: "openai", model_name: "gpt-6.1-sol", efforts: ["low", "medium", "high", "xhigh"], source: "provider",
+    });
+    const onChange = vi.fn();
+    const user = userEvent.setup();
+    render(<ReasoningEffortSelect provider="openai" modelName="gpt-6.1-sol" value="" onChange={onChange} defaultEffort="xhigh" />);
+
+    await waitFor(() => expect(screen.getAllByRole("option").length).toBeGreaterThan(1));
+    await user.selectOptions(screen.getByRole("combobox"), "low");
+    expect(onChange).toHaveBeenCalledWith("low");
+  });
+
+  it("falls back to a read-only badge for models without reasoning control", async () => {
+    listReasoningEfforts.mockResolvedValue({ provider: "openai", model_name: "gpt-4.1", efforts: [], source: "provider" });
+    render(<ReasoningEffortSelect provider="openai" modelName="gpt-4.1" value="" onChange={() => {}} defaultEffort="" />);
+
+    await waitFor(() => expect(screen.queryByRole("combobox")).not.toBeInTheDocument());
+    expect(screen.getByText(/Default \(Provider default\)/)).toBeInTheDocument();
+  });
+
+  it("falls back to a read-only badge when probe fails", async () => {
+    listReasoningEfforts.mockRejectedValue(new Error("network error"));
+    render(<ReasoningEffortSelect provider="openai" modelName="gpt-6.1-sol" value="" onChange={() => {}} defaultEffort="xhigh" />);
+
+    await waitFor(() => expect(screen.queryByRole("combobox")).not.toBeInTheDocument());
+    expect(screen.getByText(/Default \(Extra high\)/)).toBeInTheDocument();
+  });
+
+  it("is disabled while a run streams", async () => {
+    listReasoningEfforts.mockResolvedValue({ provider: "openai", model_name: "gpt-6.1-sol", efforts: ["low", "medium", "high", "xhigh"], source: "provider" });
+    render(<ReasoningEffortSelect provider="openai" modelName="gpt-6.1-sol" value="high" onChange={() => {}} disabled defaultEffort="xhigh" />);
+
+    await waitFor(() => expect(screen.getByRole("combobox")).toBeDisabled());
+  });
+
+  it("stays disabled while the model's levels load", () => {
+    listReasoningEfforts.mockImplementation(() => new Promise(() => {}));
+    render(<ReasoningEffortSelect provider="openai" modelName="o3" value="xhigh" onChange={() => {}} defaultEffort="xhigh" />);
+    expect(screen.getByRole("combobox")).toBeDisabled();
+  });
+
+  it("resets a level the current model definitely rejects", async () => {
+    listReasoningEfforts.mockResolvedValue({ provider: "openai", model_name: "o3", efforts: ["low", "medium", "high"], source: "provider" });
+    const onChange = vi.fn();
+    render(<ReasoningEffortSelect provider="openai" modelName="o3" value="xhigh" onChange={onChange} defaultEffort="xhigh" />);
+    await waitFor(() => expect(onChange).toHaveBeenCalledWith(""));
+  });
+
+  it("does not reset a level an inconclusive probe cannot confirm", async () => {
+    listReasoningEfforts.mockResolvedValue({ provider: "custom", model_name: "m", efforts: ["low", "medium", "high"], source: "default" });
+    const onChange = vi.fn();
+    render(<ReasoningEffortSelect provider="custom" modelName="m" value="xhigh" onChange={onChange} defaultEffort="xhigh" />);
+    await waitFor(() => expect(listReasoningEfforts).toHaveBeenCalled());
+    expect(onChange).not.toHaveBeenCalled();
+  });
+
+  it("re-fetches when the configured model changes", async () => {
+    listReasoningEfforts.mockResolvedValue({ provider: "openai", model_name: "gpt-5.5", efforts: ["none", "low", "medium", "high", "xhigh"], source: "provider" });
+    const { rerender } = render(<ReasoningEffortSelect provider="openai" modelName="gpt-6.1-sol" value="" onChange={() => {}} defaultEffort="xhigh" />);
+    await waitFor(() => expect(listReasoningEfforts).toHaveBeenCalledTimes(1));
+    rerender(<ReasoningEffortSelect provider="openai" modelName="gpt-5.5" value="" onChange={() => {}} defaultEffort="xhigh" />);
+    await waitFor(() => expect(listReasoningEfforts).toHaveBeenCalledTimes(2));
+    expect(listReasoningEfforts).toHaveBeenLastCalledWith({ provider: "openai", model_name: "gpt-5.5" });
+  });
+
+  it("does not expose old model options while the new probe is pending", async () => {
+    listReasoningEfforts
+      .mockResolvedValueOnce({ provider: "openai", model_name: "gpt-6.1-sol", efforts: ["low", "xhigh"], source: "provider" })
+      .mockImplementationOnce(() => new Promise(() => {}));
+    const { rerender } = render(<ReasoningEffortSelect provider="openai" modelName="gpt-6.1-sol" value="" onChange={() => {}} defaultEffort="xhigh" />);
+    await waitFor(() => expect(screen.getAllByRole("option")).toHaveLength(3));
+
+    rerender(<ReasoningEffortSelect provider="openai" modelName="o3" value="" onChange={() => {}} defaultEffort="xhigh" />);
+
+    expect(screen.getByRole("combobox")).toBeDisabled();
+    expect(screen.getAllByRole("option")).toHaveLength(1);
+  });
+});
