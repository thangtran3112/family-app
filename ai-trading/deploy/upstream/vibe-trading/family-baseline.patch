diff --git a/frontend/src/pages/__tests__/AgentReasoningEffortChoice.test.tsx b/frontend/src/pages/__tests__/AgentReasoningEffortChoice.test.tsx
new file mode 100644
index 00000000..3bbf2d86
--- /dev/null
+++ b/frontend/src/pages/__tests__/AgentReasoningEffortChoice.test.tsx
@@ -0,0 +1,139 @@
+import { act, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { createMemoryRouter, RouterProvider } from "react-router";
+import { Agent } from "../Agent";
+import { useAgentStore } from "@/stores/agent";
+import { ApiError } from "@/lib/api";
+import { toast } from "sonner";
+
+const apiMock = vi.hoisted(() => ({
+  getGoal: vi.fn(),
+  getLLMSettings: vi.fn(),
+  getRun: vi.fn(),
+  getSessionMessages: vi.fn(),
+  sseUrl: vi.fn((sid: string) => `/sessions/${sid}/events`),
+}));
+
+const sseMock = vi.hoisted(() => ({
+  connect: vi.fn(),
+  disconnect: vi.fn(),
+  onStatusChange: vi.fn(),
+}));
+
+vi.mock("@/lib/api", async () => {
+  const actual = await vi.importActual<typeof import("@/lib/api")>("@/lib/api");
+  return { ...actual, api: apiMock };
+});
+vi.mock("@/hooks/useSSE", () => ({ useSSE: () => sseMock }));
+vi.mock("@/components/chat/ModelRuntimeBar", () => ({
+  ModelRuntimeBar: ({ reasoningEffortValue, reasoningEffortDisabled, runtimeReasoningEffort, onReasoningEffortChange }: {
+    reasoningEffortValue?: string;
+    reasoningEffortDisabled?: boolean;
+    runtimeReasoningEffort?: string;
+    onReasoningEffortChange?: (value: string) => void;
+  }) => (
+    <select
+      data-testid="effort-picker"
+      value={reasoningEffortDisabled ? runtimeReasoningEffort ?? reasoningEffortValue ?? "" : reasoningEffortValue ?? ""}
+      disabled={reasoningEffortDisabled}
+      onChange={(event) => onReasoningEffortChange?.(event.target.value)}
+    >
+      <option value="">Default</option>
+      <option value="low">Low</option>
+      <option value="high">High</option>
+      <option value="xhigh">Extra high</option>
+    </select>
+  ),
+}));
+
+function storedReply(sessionId: string, reasoningEffort?: string) {
+  return {
+    message_id: `${sessionId}-reply`, session_id: sessionId, role: "assistant",
+    content: "done", created_at: "2026-08-01T00:00:00Z",
+    linked_attempt_id: `${sessionId}-attempt`, tool_trail: [],
+    metadata: reasoningEffort ? { provider: "openai", model: "gpt-6.1-sol", reasoning_effort: reasoningEffort } : {},
+  };
+}
+
+function mountAt(path: string) {
+  const router = createMemoryRouter([{ path: "/", element: <Agent /> }], { initialEntries: [path] });
+  render(<RouterProvider router={router} />);
+  return router;
+}
+
+describe("Agent per-chat reasoning effort choice", () => {
+  afterEach(() => { vi.restoreAllMocks(); });
+  beforeEach(() => {
+    useAgentStore.getState().reset();
+    apiMock.getGoal.mockResolvedValue(null);
+    apiMock.getLLMSettings.mockResolvedValue({
+      provider: "openai", model_name: "gpt-6.1-sol", base_url: "https://api.openai.com/v1",
+      api_key_configured: true, api_key_required: true, temperature: 0,
+      timeout_seconds: 120, max_retries: 2, reasoning_effort: "xhigh",
+      sse_timeout_seconds: 90, env_path: "agent/.env", providers: [],
+    });
+    Object.defineProperty(HTMLElement.prototype, "scrollTo", { configurable: true, value: vi.fn() });
+  });
+
+  it("initializes from the last assistant message's metadata.reasoning_effort", async () => {
+    apiMock.getSessionMessages.mockResolvedValue([storedReply("session-one", "low")]);
+    mountAt("/?session=session-one");
+    await waitFor(() => expect(screen.getByTestId("effort-picker")).toHaveValue("low"));
+  });
+
+  it("defaults a chat with no prior reasoning effort metadata", async () => {
+    apiMock.getSessionMessages.mockResolvedValue([storedReply("session-one")]);
+    mountAt("/?session=session-one");
+    await waitFor(() => expect(apiMock.getSessionMessages).toHaveBeenCalled());
+    expect(screen.getByTestId("effort-picker")).toHaveValue("");
+  });
+
+  it("a brand new chat starts at Default", () => {
+    mountAt("/");
+    expect(screen.getByTestId("effort-picker")).toHaveValue("");
+  });
+
+  it("disables the picker while streaming", async () => {
+    apiMock.getSessionMessages.mockResolvedValue([]);
+    mountAt("/?session=session-one");
+    await waitFor(() => expect(sseMock.connect).toHaveBeenCalled());
+    act(() => { useAgentStore.getState().setStatus("streaming"); });
+    await waitFor(() => expect(screen.getByTestId("effort-picker")).toBeDisabled());
+  });
+
+  it("does not display a prior reply's effort while a new selection streams", async () => {
+    apiMock.getSessionMessages.mockResolvedValue([storedReply("session-one", "low")]);
+    mountAt("/?session=session-one");
+    await waitFor(() => expect(screen.getByTestId("effort-picker")).toHaveValue("low"));
+
+    fireEvent.change(screen.getByTestId("effort-picker"), { target: { value: "high" } });
+    act(() => { useAgentStore.getState().setStatus("streaming"); });
+
+    expect(screen.getByTestId("effort-picker")).toBeDisabled();
+    expect(screen.getByTestId("effort-picker")).toHaveValue("high");
+  });
+
+  it("keeps each chat's unsent choice when switching sessions", async () => {
+    apiMock.getSessionMessages.mockImplementation(async (sid: string) => [
+      storedReply(sid, sid === "session-one" ? "low" : "high"),
+    ]);
+    const router = mountAt("/?session=session-one");
+    await waitFor(() => expect(screen.getByTestId("effort-picker")).toHaveValue("low"));
+    fireEvent.change(screen.getByTestId("effort-picker"), { target: { value: "xhigh" } });
+    await act(async () => { await router.navigate("/?session=session-two"); });
+    await waitFor(() => expect(screen.getByTestId("effort-picker")).toHaveValue("high"));
+    fireEvent.change(screen.getByTestId("effort-picker"), { target: { value: "low" } });
+    await act(async () => { await router.navigate("/?session=session-one"); });
+    await waitFor(() => expect(screen.getByTestId("effort-picker")).toHaveValue("xhigh"));
+    await act(async () => { await router.navigate("/?session=session-two"); });
+    await waitFor(() => expect(screen.getByTestId("effort-picker")).toHaveValue("low"));
+  });
+
+  it("surfaces a real unknown-session goal 404 instead of treating it as no goal", async () => {
+    apiMock.getSessionMessages.mockResolvedValue([]);
+    apiMock.getGoal.mockRejectedValue(new ApiError("Session not found", 404));
+    const alert = vi.spyOn(toast, "error").mockImplementation(() => "test");
+    mountAt("/?session=session-one");
+
+    await waitFor(() => expect(alert).toHaveBeenCalledWith("Session not found"));
+  });
+});
