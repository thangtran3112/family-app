+# ---------------------------------------------------------------------------
+# Model-specific reasoning efforts (live-probed, never a hardcoded list)
+# ---------------------------------------------------------------------------
+
+SOL_MESSAGE = (
+    "Unsupported value: 'reasoning_effort' does not support '__probe__' with this "
+    "model. Supported values are: 'low', 'medium', 'high', and 'xhigh'."
+)
+
+
+def _fake_openai(monkeypatch: pytest.MonkeyPatch, status_code: int, message: str) -> list:
+    """Route settings_routes' httpx calls to a canned OpenAI error; return the requests."""
+    import httpx
+
+    seen: list = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        seen.append(request)
+        return httpx.Response(status_code, json={"error": {"message": message}})
+
+    real = httpx.AsyncClient
+    monkeypatch.setattr(
+        settings_routes.httpx,
+        "AsyncClient",
+        lambda **kwargs: real(transport=httpx.MockTransport(handler), **kwargs),
+    )
+    return seen
+
+
+def _discover(provider: str, model: str, base_url: str = "https://api.openai.com/v1", key: str = "sk-test"):
+    import asyncio
+
+    return asyncio.run(
+        settings_routes._discover_reasoning_efforts(
+            settings_routes.LLM_PROVIDER_BY_NAME[provider],
+            model_name=model,
+            base_url=base_url,
+            api_key=key,
+        )
+    )
+
+
+def test_reasoning_efforts_come_from_the_models_own_error(monkeypatch: pytest.MonkeyPatch) -> None:
+    seen = _fake_openai(monkeypatch, 400, SOL_MESSAGE)
+
+    result = _discover("openai", "gpt-6.1-sol")
+
+    assert result.source == "provider"
+    assert result.efforts == ["low", "medium", "high", "xhigh"]  # no "max", no "none"
+    assert len(seen) == 1
+    assert seen[0].url.path == "/v1/chat/completions"
+    assert seen[0].headers["authorization"] == "Bearer sk-test"
+    assert b"__probe__" in seen[0].content  # invalid on purpose: nothing is generated
+
+
+def test_reasoning_efforts_follow_the_model_not_a_fixed_list(monkeypatch: pytest.MonkeyPatch) -> None:
+    _fake_openai(
+        monkeypatch,
+        400,
+        "Unsupported value: 'reasoning_effort' does not support '__probe__' with this model. "
+        "Supported values are: 'none', 'low', 'medium', 'high', and 'xhigh'.",
+    )
+
+    assert _discover("openai", "gpt-5.5").efforts == ["none", "low", "medium", "high", "xhigh"]
+
+
+def test_reasoning_efforts_empty_for_models_without_reasoning(monkeypatch: pytest.MonkeyPatch) -> None:
+    # Verbatim from OpenAI's /v1/chat/completions for gpt-4.1 and gpt-4o.
+    _fake_openai(monkeypatch, 400, "Unrecognized request argument supplied: reasoning_effort")
+
+    result = _discover("openai", "gpt-4.1")
+
+    assert (result.efforts, result.source) == ([], "provider")
+
+
+@pytest.mark.parametrize("status_code,message", [(500, "boom"), (404, "model not found"), (400, "something unexpected")])
+def test_reasoning_efforts_fall_back_when_the_probe_is_inconclusive(
+    monkeypatch: pytest.MonkeyPatch, status_code: int, message: str,
+) -> None:
+    _fake_openai(monkeypatch, status_code, message)
+
+    result = _discover("openai", "gpt-6.1-sol")
+
+    assert (result.efforts, result.source) == (settings_routes.LLM_FALLBACK_REASONING_EFFORTS, "default")
+
+
+def test_reasoning_efforts_never_send_the_key_beyond_direct_openai(monkeypatch: pytest.MonkeyPatch) -> None:
+    seen = _fake_openai(monkeypatch, 400, SOL_MESSAGE)
+
+    other_provider = _discover("deepseek", "deepseek-v4-pro", base_url="https://api.deepseek.com/v1")
+    proxied_openai = _discover("openai", "gpt-6.1-sol", base_url="https://proxy.example.com/v1")
+    no_key = _discover("openai", "gpt-6.1-sol", key="")
+
+    assert seen == []
+    for result in (other_provider, proxied_openai, no_key):
+        assert result.source == "default"
+
+
+def test_reasoning_efforts_route_returns_probed_list(
+    client: TestClient, monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _fake_openai(monkeypatch, 400, SOL_MESSAGE)
+
+    response = client.post(
+        "/settings/llm/reasoning-efforts",
