+
+class CommitteeGate:
+    """Hold trusted facts and one committee attempt for a top-level chat turn."""
+
+    def __init__(self, user_message: str, history: list[dict] | None,
+                 *, bridge_fetcher=fetch_counts) -> None:
+        self.own_intent = needs_committee(user_message, history)
+        explicit_non_us = bool(re.search(
+            r"\b[A-Z0-9.-]+\.(?:HK|L|TO|SS|SH|SZ|NS|BO|V|BA)\b", user_message, re.I
+        ) and not re.search(r"\.US\b", user_message, re.I))
+        explicit_non_us |= bool(
+            re.search(r"ETF|基金", user_message, re.I)
+            and not re.search(r"\.US\b|\bstock\b|美股", user_message, re.I)
+        )
+        self.buffering = not explicit_non_us and bool(self.own_intent or re.search(
+            r"\b(stock|shares|ticker|equity|analysts?|earnings|price target|financials|[A-Z]{2,5}(?:\.[A-Z]{1,3})?)\b|股票|股价|سهم",
+            user_message,
+        ))
+        self.attempted = False
+        self.release_checked = False
+        self.release_checks: list[str] = []
+        self._saw_swarm_events = False
+        self._suppress_swarm_events = False
+        self._proof: dict = {"status": "analysis_only", "reason": "no_committee"}
+        self.yahoo_snapshot: dict | None = None
+        self.quote_fact: dict | None = None
+        self.sec_fact: dict | None = None
+        self.bridge_fetcher = bridge_fetcher
+
+    def sanitize_event(self, event_type: str, data: dict) -> dict | None:
+        """Allow only fixed progress fields before any SSE/checkpoint subscriber."""
+        if self.buffering and event_type.startswith("swarm."):
+            self._saw_swarm_events = True
+        if self._suppress_swarm_events and event_type.startswith("swarm."):
+            return None
+        if not self.buffering and ((not self.attempted and not self._saw_swarm_events)
+                                   or not event_type.startswith("swarm.")):
+            return data
+        if event_type == "text_delta":
+            return None
+        if event_type == "reasoning_delta":
+            return {key: data[key] for key in ("iter", "chars") if type(data.get(key)) is int}
+        if event_type == "swarm.event":
+            stage = data.get("stage")
+            if stage is None:
+                nested = data.get("event")
+                stage = nested.get("type") if isinstance(nested, dict) else None
+                task_id = nested.get("task_id") if isinstance(nested, dict) else None
+            else:
+                task_id = data.get("task_id")
+            if stage not in {"run_started", "layer_started", "worker_started", "worker_completed",
+                             "task_completed", "run_completed"}:
+                return None
+            return {"stage": stage, "task_id": task_id if task_id in _TASKS else None}
+        if event_type in {"tool_call", "tool_result", "swarm.started", "tool_progress"}:
+            safe = {}
+            for key in ("tool", "call_id", "status", "stage", "elapsed_ms", "iter",
+                        "current", "done", "total", "preset"):
+                value = data.get(key)
+                if key in {"elapsed_ms", "iter", "current", "done", "total"}:
+                    if type(value) is int and value >= 0:
+                        safe[key] = value
+                elif isinstance(value, str) and re.fullmatch(r"[A-Za-z0-9_.-]{1,80}", value):
+                    safe[key] = value
+            return safe
+        if event_type in {"grounding_status", "iteration", "llm_usage", "thinking_done"}:
+            return {key: data[key] for key in ("iter", "chars", "round", "issues", "total_tokens",
+                                             "flagged", "removed") if type(data.get(key)) is int}
+        return None
+
+    @staticmethod
+    def safe_trace(entry: dict) -> dict:
+        """Persist metadata only while a US-stock answer is quarantined."""
+        allowed = ("type", "iter", "tool", "call_id", "status", "elapsed_ms", "ts")
+        return {key: entry[key] for key in allowed if key in entry
+                and (type(entry[key]) in (int, float) or
+                     isinstance(entry[key], str) and re.fullmatch(r"[A-Za-z0-9_.-]{1,80}", entry[key]))}
+
+    def ingest_tool_result(self, name: str, arguments: dict, full_result: str,
+                           call_id: str, *, now: datetime | None = None) -> None:
+        """Project only successful full Yahoo/SEC tool results into checked facts."""
+        if name not in {"get_stock_profile", "get_sec_filings"} or len(full_result) > 2_000_000:
+            return
+        try:
+            payload = json.loads(full_result)
+        except (ValueError, TypeError):
+            return
+        if not isinstance(payload, dict) or payload.get("ok") is not True:
+            return
+        now = now or datetime.now(timezone.utc)
+        raw = arguments.get("ticker")
+        if not isinstance(raw, str):
+            return
+        bare = raw.upper().removesuffix(".US")
+        ticker = bare + ".US"
+        if not _US_TICKER.fullmatch(ticker):
+            return
+        data = payload.get("data")
+        if not isinstance(data, dict):
+            return
+        if name == "get_stock_profile":
+            listing = data.get("listing") or {}
+            sections = data.get("sections") or {}
+            if (payload.get("source") != "yahoo" or payload.get("market") != "us"
+                    or data.get("ticker") != raw or not isinstance(listing, dict)
+                    or listing.get("symbol") != map_symbol(ticker)
+                    or listing.get("currency") != "USD"
+                    or listing.get("exchange") not in {"NMS", "NYQ", "ASE", "NGM", "NCM", "PCX", "BATS"}
+                    or listing.get("quote_type") != "EQUITY"
+                    or not isinstance(sections, dict)):
+                return
+            rows = sections.get("recommendation_trend") or []
+            if not isinstance(rows, list):
+                return
+            current = next((row for row in rows if isinstance(row, dict) and row.get("period") == "0m"), None)
+            if current is None or not _counts_valid(current):
+                return
+            timestamp = now.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+            self.yahoo_snapshot = {"status": "ok", "symbol": ticker, "source": "yahoo",
+                                   "period": "0m", "call_id": call_id, "retrieved_at": timestamp,
+                                   **{field: current[field] for field in _COUNT_NAMES}}
+            financials = sections.get("financials") or {}
+            price = financials.get("currentPrice") if isinstance(financials, dict) else None
+            quote_timestamp = listing.get("quote_timestamp")
+            if type(price) in (int, float) and price > 0 and type(quote_timestamp) is int:
+                try:
+                    as_of = datetime.fromtimestamp(quote_timestamp, timezone.utc).isoformat().replace("+00:00", "Z")
+                except (ValueError, OverflowError, OSError):
+                    as_of = None
+                if as_of is not None:
+                    self.quote_fact = {"symbol": ticker, "source": "yahoo", "currency": "USD",
+                                       "price": price, "as_of": as_of, "retrieved_at": timestamp, "call_id": call_id}
+            return
+        metric = data.get("metric") or {}
+        if (payload.get("source") != "sec_edgar" or payload.get("market") != "US"
+                or data.get("ticker") != bare or not isinstance(metric, dict)
+                or metric.get("concept") != "EarningsPerShareDiluted"
+                or metric.get("unit") != "USD/shares"):
+            return
+        points = metric.get("points") or []
+        if not isinstance(points, list):
+            return
+        eligible = []
+        for point in points:
+            if not isinstance(point, dict) or point.get("form") != "10-K":
+                continue
+            try:
+                filed = date.fromisoformat(point["filed"])
+                period = date.fromisoformat(point["end"])
+                if (point.get("period_type") == "annual" and filed <= now.date()
+                        and type(point.get("period_days")) is int
+                        and 330 <= point["period_days"] <= 400
+                        and type(point.get("val")) in (int, float)):
+                    eligible.append((period, filed, point))
+            except (KeyError, ValueError, TypeError):
+                continue
+        if not eligible:
+            return
+        period, _, point = max(eligible, key=lambda row: row[:2])
+        self.sec_fact = {"symbol": ticker, "value": str(point["val"]), "unit": "USD/shares",
+                         "period_end": period.isoformat(), "filed": point["filed"],
+                         "form": "10-K", "period_days": point["period_days"],
+                         "accession": point.get("accession"), "call_id": call_id, "latest": True}
+
+    @staticmethod
+    def single_locked_us_symbol(ledger: Any) -> str | None:
+        symbols = set(getattr(ledger, "authorized_symbols", ()))
+        return next(iter(symbols)) if len(symbols) == 1 and _US_TICKER.fullmatch(next(iter(symbols))) else None
+
+    def orchestrate(self, registry: Any, user_message: str, symbol: str | None,
+                    ledger: Any, run_dir: Path, *, now: datetime,
+                    should_cancel: Callable[[], bool] | None = None) -> dict:
+        """Launch exactly one host-controlled committee, then check its on-disk proof."""
+        if self.attempted:
+            return self._proof
+        self.attempted = True
+        if symbol is None or not _US_TICKER.fullmatch(symbol):
+            self._proof = {"status": "analysis_only", "reason": "ambiguous_us_symbol"}
+            return self._proof
+        token = os.environ.get("API_AUTH_KEY", "")
+        try:
+            bridge = self.bridge_fetcher(symbol, token, os.environ.get("VIBE_CONSENSUS_URL", _BRIDGE_ORIGIN))
+        except (OSError, ValueError, TypeError):
+            bridge = {"status": "unavailable", "reason": "upstream"}
+        # The model may have omitted the current trend or annual EPS; fetch via
+        # the same registered readonly tools, not a new provider client.
+        for name, params in (
+            ("get_stock_profile", {"ticker": symbol, "sections": ["recommendation_trend", "financials"]}),
+            ("get_sec_filings", {"ticker": symbol[:-3], "metric": "EarningsPerShareDiluted", "form": "10-K", "limit": 20}),
+        ):
+            if ((name == "get_stock_profile" and self.yahoo_snapshot is not None)
+                    or (name == "get_sec_filings" and self.sec_fact is not None)
+                    or not callable(getattr(registry, "get", None)) or registry.get(name) is None):
+                continue
+            result = registry.execute(name, params)
+            try:
+                success = json.loads(result).get("ok") is True
+            except (ValueError, AttributeError, TypeError):
+                success = False
+            if success:
+                call_id = "committee-" + uuid.uuid4().hex[:12]
+                if callable(getattr(ledger, "ingest_tool_result", None)):
+                    ledger.ingest_tool_result(tool_name=name, arguments=params, result=result,
+                                              call_id=call_id, success=True)
+                self.ingest_tool_result(name, params, result, call_id, now=now)
+        context = (
+            format_consensus_context(bridge, self.yahoo_snapshot,
+                                     sec_fact=self.sec_fact, quote_fact=self.quote_fact)
+            if bridge.get("status") == "ok" and self.yahoo_snapshot is not None
+            else "Independent recommendation corroboration unavailable; mark incomplete."
+        )
+        params = {"prompt": f"Review {symbol} for a US-listed investment committee; no orders.",
+                  "preset_name": "investment_committee",
+                  "variables": {"target": symbol, "market": "US", "parent_run_id": Path(run_dir).name,
+                                "consensus_context": context}}
+        from src.tools.swarm_tool import execute_private_committee, private_committee_runs_root
+
+        try:
+            if should_cancel is None:
+                raw = execute_private_committee(registry, params)
+            else:
+                finished = threading.Event()
+                reply: dict[str, Any] = {}
+
+                def run_swarm() -> None:
+                    try:
+                        reply["raw"] = execute_private_committee(registry, params)
+                    except Exception:  # noqa: BLE001 - report failure to parent, never log a provider body
+                        reply["error"] = True
+                    finally:
+                        finished.set()
+
+                threading.Thread(target=run_swarm, name="committee-wait", daemon=True).start()
+                while not finished.wait(0.1):
+                    if should_cancel():
+                        self._suppress_swarm_events = True
+                        self._proof = {"status": "analysis_only", "reason": "committee_cancelled"}
+                        break
+                if self._suppress_swarm_events:
+                    raw = '{"status":"cancelled"}'
+                elif reply.get("error"):
+                    raw = '{"status":"error"}'
+                else:
+                    raw = reply["raw"]
+            result = json.loads(raw)
+            if result.get("status") != "completed" or result.get("wait_budget_exhausted"):
+                if not self._suppress_swarm_events:
+                    self._proof = {"status": "analysis_only", "reason": "committee_incomplete"}
+            elif not self._suppress_swarm_events:
+                from backtest.loaders.yahoo_client import get_split_events
+
+                splits = None
+                if self.sec_fact and self.quote_fact:
+                    try:
+                        start = date.fromisoformat(self.sec_fact["period_end"])
+                        end = date.fromisoformat(self.quote_fact["as_of"][:10])
+                        splits = get_split_events(symbol, start, end)
+                    except (ValueError, TypeError, OSError):
+                        pass
+                self._proof = verify_committee(
+                    result.get("run_id", ""), symbol, private_committee_runs_root(), ledger,
+                    bridge, self.yahoo_snapshot or {}, now=datetime.now(timezone.utc),
+                    sec_fact=self.sec_fact, quote_fact=self.quote_fact, split_events=splits,
+                )
+        except (OSError, ValueError, TypeError, AttributeError):
+            self._proof = {"status": "analysis_only", "reason": "committee_unavailable"}
+        artifact = Path(run_dir) / "artifacts" / "committee_proof.json"
+        try:
+            artifact.parent.mkdir(parents=True, exist_ok=True)
+            tmp = artifact.with_suffix(".json.tmp")
+            tmp.write_text(json.dumps(self._proof, ensure_ascii=False))
+            tmp.replace(artifact)
+        except OSError:
+            self._proof = {"status": "analysis_only", "reason": "proof_not_durable"}
+        return self._proof
+
+    def release(self, raw_answer: str, proof: dict, llm: Any, *, ledger: Any = None) -> str:
+        """Rewrite/check analysis independently, then append only typed verdict fields."""
+        self.release_checked = False
+        self.release_checks = []
+        notice = "Analysis-only: I could not verify a safe recommendation for this US stock. No order was placed."
+        for attempt in range(3):
+            try:
+                if attempt == 0:
+                    candidate = raw_answer if len(raw_answer) <= 15000 else ""
+                else:
+                    candidate = llm.chat([
+                        {"role": "system", "content": "Rewrite the following into factual analysis only. Remove every own Buy/Sell/Hold recommendation and own numeric price target. Retain supported neutral findings and attributed third-party facts; do not invent data."},
+                        {"role": "user", "content": raw_answer[:15000]},
+                    ], tools=None, timeout=60).content.strip()
+                if not candidate.strip():
+                    self.release_checks.append("empty")
+                    continue
+                if _unsafe_own_advice(candidate):
+                    self.release_checks.append("unsafe")
+                    continue
+                classified = llm.chat([
+                    {"role": "system", "content": "Classify whether this text contains the assistant's own Buy/Sell verdict or numeric price target in any language. Reply ONLY JSON with boolean own_verdict, own_target, uncertain. Attributed analyst facts are not own claims."},
+                    {"role": "user", "content": candidate},
+                ], tools=None, timeout=30).content
+                verdict = json.loads(classified)
+                if (isinstance(verdict, dict) and set(verdict) == {"own_verdict", "own_target", "uncertain"}
+                        and all(type(verdict[k]) is bool for k in verdict)
+                        and not any(verdict.values())):
+                    if ledger is not None:
+                        released = getattr(ledger, "_released", None)
+                        if (not isinstance(released, dict) or
+                                released.get("content_sha256") != hashlib.sha256(candidate.encode()).hexdigest()):
+                            grounding = ledger.revalidate(candidate)
+                            if not grounding.valid:
+                                self.release_checks.append("grounding_reject")
+                                continue
+                            candidate = grounding.released_text
+                    issued = render_recommendation(proof)
+                    if self.attempted:
+                        note = ("The automatic committee completed review and approved the checked verdict below."
+                                if proof.get("status") == "approved" else
+                                "The automatic committee ran but did not approve an own verdict because required independent corroboration was unavailable."
+                                if proof.get("reason") == "unverified_committee" else None)
+                        if note:
+                            candidate = _FALSE_RUNNER_CLAIM.sub(note, candidate)
+                    self.release_checked = True
+                    self.release_checks.append("checked")
+                    return candidate + ("\n\n" + issued if issued else "")
+                self.release_checks.append("classifier_reject")
+            except Exception:  # noqa: BLE001 - classifier outage must never release an unchecked draft
+                self.release_checks.append("error")
+                return notice
+        return notice
+
+
+_OWN_ADVICE = re.compile(
+    r"\b(?:i\s+(?:would|recommend|rate)|my\s+(?:own\s+)?(?:target|rating|recommendation)|"
+    r"(?:buy|sell|hold)\s+(?:now|this|the|[A-Z]{1,5}\b)|"
+    r"(?:price\s+target|target\s+price)\s*(?:of|is|:)?\s*[$€£]?\d)\b|"
+    r"(?:我建议|我的目标价|建议买入|建议卖出|أوصي بالشراء|هدفي السعري)", re.I
+)
+_FIRST_PERSON_ADVICE = re.compile(
+    r"\b(?:i\s+(?:would|recommend|rate)\b|my\s+(?:own\s+)?(?:target|rating|recommendation)\b)"
+    r"|(?:我建议|我的目标价|أوصي بالشراء|هدفي السعري)", re.I
+)
+_FALSE_RUNNER_CLAIM = re.compile(
+    r"(?:I could not convene the requested investment committee because its runner is unavailable in this session|"
+    r"the investment committee could not be convened because the committee-runner tool is unavailable)\.", re.I
+)
+
+
+def _unsafe_own_advice(text: str) -> bool:
+    if re.search(r"<family-us-decision>|\"(?:verdict|candidate_target)\"\s*:", text, re.I):
+        return True
+    if re.search(r"(?im)^\s*(?:recommendation:\s*)?buy[- ]and[- ]hold\s+[A-Z]{1,5}(?:\.US)?\.?\s*$", text):
+        return True
+    if re.search(r"\bbuy[- ]and[- ]hold\s+[A-Z]{1,5}\s+now\b", text, re.I):
+        return True
+    text = re.sub(r"\bbuy[- ]and[- ]hold\b", "passive benchmark", text, flags=re.I)
+    for sentence in re.split(r"[.。!?！؟\n]+", text):
+        if _FIRST_PERSON_ADVICE.search(sentence):
+            return True
+        if _OWN_ADVICE.search(sentence) and not re.search(
+            r"\b(?:yahoo|analysts?|third.party|consensus|according to)\b|分析师|المحللين", sentence, re.I
+        ):
+            return True
+    return False
